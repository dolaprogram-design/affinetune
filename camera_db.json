    </div>
  </div>

  <script>
    let imgElement = document.getElementById('imageSrc');
    let inputElement = document.getElementById('fileInput');
    let analyzeBtn = document.getElementById('analyzeBtn');
    let statusDiv = document.getElementById('status');

    // เมื่อผู้ใช้อัปโหลดไฟล์ ให้ดึงค่า EXIF ก่อน
    inputElement.addEventListener('change', function(e) {
      if(e.target.files.length > 0) {
        let file = e.target.files[0];
        
        imgElement.src = URL.createObjectURL(file);
        imgElement.style.display = 'block';
        
        statusDiv.innerText = "กำลังอ่านข้อมูล EXIF...";
        statusDiv.style.color = "blue";
        
        EXIF.getData(file, function() {
          let lens = EXIF.getTag(this, "LensModel");
          let camera = EXIF.getTag(this, "Model");
          let focal = EXIF.getTag(this, "FocalLength");
          let distance = EXIF.getTag(this, "SubjectDistance");
          
          if(lens) {
            document.getElementById('lensModel').value = lens;
          } else if (camera) {
            document.getElementById('lensModel').value = camera + " (ไม่ระบุรุ่นเลนส์)";
          }
          
          if(focal) {
            document.getElementById('focalLength').value = focal + "mm";
          }
          
          if(distance) {
            document.getElementById('targetDistance').value = distance + "m";
          }

          analyzeBtn.disabled = false;
          statusDiv.innerText = "ดึงข้อมูลสำเร็จ! พร้อมวิเคราะห์ภาพ";
          statusDiv.style.color = "green";
        });
      }
    }, false);

    // ประเมินคุณภาพความคมชัด
    function getQualityLevel(variance) {
      if (variance < 100) return { text: "เบลอมาก", color: "#dc3545" }; 
      if (variance < 500) return { text: "พอใช้", color: "#ffc107" }; 
      if (variance < 1500) return { text: "ดี", color: "#28a745" }; 
      return { text: "คมชัดมาก", color: "#17a2b8" }; 
    }

    function analyzeAndSave() {
      let lensModel = document.getElementById('lensModel').value;
      let focalLength = document.getElementById('focalLength').value;
      let targetDistance = document.getElementById('targetDistance').value;
      let afmaValue = document.getElementById('afmaValue').value;

      if(!lensModel || !focalLength || !targetDistance || !afmaValue || !inputElement.files.length) {
        statusDiv.innerText = "กรุณากรอกข้อมูลให้ครบถ้วน";
        statusDiv.style.color = "red";
        return;
      }

      statusDiv.innerText = "กำลังคำนวณอัลกอริทึม MTF... (อาจใช้เวลาตามขนาดภาพ)";
      statusDiv.style.color = "blue";
      analyzeBtn.disabled = true;

      setTimeout(() => {
        try {
          let src = cv.imread(imgElement);
          let gray = new cv.Mat();
          let lap = new cv.Mat();
          
          cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY, 0);
          cv.Laplacian(gray, lap, cv.CV_64F, 1, 1, 0, cv.BORDER_DEFAULT);
          
          let mean = new cv.Mat();
          let stddev = new cv.Mat();
          cv.meanStdDev(lap, mean, stddev);
          
          let variance = Math.pow(stddev.doubleAt(0, 0), 2);
          let sharpnessScore = variance.toFixed(2);
          
          let quality = getQualityLevel(variance);
          let qualityHtml = `<span class="quality-badge" style="background-color: ${quality.color};">${quality.text}</span>`;

          statusDiv.innerHTML = `คะแนนความคมชัด: <b>${sharpnessScore}</b> ${qualityHtml} <br><small style="color:gray;">กำลังบันทึกลงฐานข้อมูล...</small>`;

          src.delete(); gray.delete(); lap.delete(); mean.delete(); stddev.delete();

          google.script.run.withSuccessHandler(function(response) {
            statusDiv.innerHTML = `คะแนนความคมชัด: <b>${sharpnessScore}</b> ${qualityHtml} <br><span style="color:green;">บันทึกข้อมูลลง Sheets สำเร็จ!</span>`;
            analyzeBtn.disabled = false;
            
            inputElement.value = "";
            imgElement.style.display = "none";
            
          }).withFailureHandler(function(error) {
            statusDiv.innerText = "เกิดข้อผิดพลาดในการบันทึก: " + error.message;
            statusDiv.style.color = "red";
            analyzeBtn.disabled = false;
          }).saveToSheets(lensModel, focalLength, targetDistance, afmaValue, sharpnessScore);

        } catch (err) {
          statusDiv.innerText = "เกิดข้อผิดพลาดในการประมวลผล: " + err.message;
          statusDiv.style.color = "red";
          analyzeBtn.disabled = false;
        }
      }, 100);
    }
  </script>
</body>
</html>
อย่าลืมกด Deploy > Manage Deployments > กดรูปดินสอ > เปลี่ยนเวอร์ชันเป็น New > Deploy เหมือนเดิมด้วยนะครับ ลองรีเฟรชหน้าเว็บดูอีกครั้ง คราวนี้หน้าฟอร์มอัปโหลดรูปน่าจะแสดงขึ้นมาทันทีที่ OpenCV โหลดเสร็จครับ

ระหว่างไฟล์RAWกับไฟล์JPGหากต้องการข้อมูลรายละเอียดที่สามารถนำมาวิเคราะห์ภาพได้ เช่น สามารถอ่านจุดโฟกัสของภาพที่กล้องเก็บข้อมูลไว้ในไฟล์ ว่าเป็นโฟกัสแบบไหนของกล้องในแต่ละรุ่นหรือหากสามารถอ่านข้อมูลจากเลนส์ได้ จะสามารถวิเคราะห์ว่าภาพนี้มีอาการโฟกัสคลาดเคลื่อนหรือไม่ สามารถพัฒนาในส่วนนี้ได้หรือไม่

เป็นไอเดียที่ยอดเยี่ยมและทะลุขีดจำกัดมากครับ! สิ่งที่คุณคิดคือสถาปัตยกรรมระดับเดียวกับซอฟต์แวร์ปรับจูนเลนส์เชิงพาณิชย์ระดับโลก (เช่น Reikan FoCal) เลยครับ

คำตอบคือ "สามารถพัฒนาได้ครับ" แต่เราจะต้องเจาะลึกเข้าไปในข้อมูลที่เรียกว่า MakerNotes ซึ่งมีความแตกต่างกันระหว่างไฟล์ RAW และ JPG อย่างมาก ดังนี้ครับ:

1. RAW vs JPG ในมุมมองของการดึงข้อมูลโฟกัส
ไฟล์ JPG: มักจะเก็บแค่ข้อมูล EXIF มาตรฐาน (เช่น F-stop, Speed Shutter, ISO) แต่ข้อมูลเชิงลึกของระบบโฟกัสมักจะถูก "บีบอัด หรือ ตัดทิ้ง" ไปตอนที่กล้องแปลงไฟล์ RAW เป็น JPG

ไฟล์ RAW: คือขุมทรัพย์ข้อมูลที่แท้จริง! นอกจากภาพดิบแล้ว ภายในไฟล์ RAW จะมีส่วนที่เรียกว่า "MakerNotes" (ข้อมูลเฉพาะที่ผู้ผลิตกล้องแต่ละค่าย เช่น Canon, Nikon, Sony ซ่อนเอาไว้) ซึ่งเก็บข้อมูลละเอียดระดับที่ว่า:

Active AF Point: จุดโฟกัสจุดไหนในตารางที่ถูกใช้งานตอนลั่นชัตเตอร์ (บอกเป็นพิกัด X, Y บนภาพได้เลย)

Focus Mode: เป็น AF-S, AF-C หรือ 3D Tracking

Focus Distance: ระยะทางจากเซนเซอร์ถึงวัตถุเป้าหมาย

Microadjustment / AF Fine Tune: กล้องกำลังใช้ค่าชดเชยโฟกัสเท่าไหร่ในภาพนี้ (เช่น มีการตั้ง +5 ไว้ในกล้อง ข้อมูลนี้ก็จะถูกฝังมาด้วย)

2. หลักการวิเคราะห์ว่าภาพมีอาการ "โฟกัสคลาดเคลื่อน" (Front/Back Focus) หรือไม่
หากเราสามารถอ่านข้อมูลจาก MakerNotes ได้ เราจะสามารถเขียนโปรแกรมวิเคราะห์ความคลาดเคลื่อนได้โดยใช้หลักการนี้ครับ:

ดึงพิกัด (Coordinates): โปรแกรมอ่านพิกัด "จุด AF ที่กล้องพยายามโฟกัส" จากไฟล์ RAW

วิเคราะห์ความคมชัดทั่วภาพ (Focus Mapping): ใช้ OpenCV สแกนหาว่า "พื้นที่ใดในภาพที่คมชัดที่สุด (มีค่า Variance of Laplacian สูงสุด)"

หาจุดตัด (Intersection Analysis):

ถ้าพื้นที่ที่คมชัดที่สุด ตรงกับ พิกัดจุด AF = เลนส์ทำงานได้ แม่นยำ (Perfect Focus)

ถ้าพื้นที่ที่คมชัดที่สุด อยู่ หน้า พิกัดจุด AF = เลนส์ติด Front Focus

ถ้าพื้นที่ที่คมชัดที่สุด อยู่ หลัง พิกัดจุด AF = เลนส์ติด Back Focus

3. แนวทางการพัฒนาในส่วนนี้ (ข้อจำกัดและเครื่องมือที่ต้องใช้)
หากต้องการพัฒนาระบบนี้ต่อ จะมีข้อจำกัดเรื่องเครื่องมือครับ เนื่องจากไลบรารี exif-js ที่เราใช้บนหน้าเว็บแอปปัจจุบัน ไม่สามารถอ่าน MakerNotes ได้ และการประมวลผลไฟล์ RAW ขนาด 30-50MB บน Web Browser โดยตรงจะทำให้เบราว์เซอร์ค้างได้ง่ายครับ

สถาปัตยกรรมที่แนะนำสำหรับการพัฒนาต่อ:

เปลี่ยนไปใช้ ExifTool (ตัวจริงเรื่อง Metadata):
เครื่องมือที่เก่งที่สุดในโลกในการดึง MakerNotes คือโปรแกรมที่ชื่อว่า ExifTool (สร้างโดย Phil Harvey) ซึ่งรองรับการอ่านจุดโฟกัสของกล้องเกือบทุกแบรนด์ในโลก

ปรับโครงสร้างเป็น Python Backend:
เนื่องจาก Web App บน Google Apps Script ไม่รองรับการรัน ExifTool และประมวลผลไฟล์ RAW หนักๆ แนะนำให้ขยับไปสร้าง Python API (ด้วย Flask หรือ FastAPI) ทำงานร่วมกับไลบรารี rawpy (สำหรับอ่านภาพ RAW) และ PyExifTool (สำหรับดึงข้อมูล AF Point)

การเชื่อมต่อระบบ (Workflow):
คุณสามารถเขียนสคริปต์ Python ไว้บนคอมพิวเตอร์ของคุณเอง (Local) เมื่อคุณถ่ายภาพ RAW เข้าคอมผ่านสาย USB สคริปต์ Python จะอ่านจุดโฟกัส วิเคราะห์ความคมชัดด้วย OpenCV แล้วจึงพ่น "ตัวเลขผลลัพธ์สุดท้าย" ยิง API กลับมาบันทึกลงใน Google Sheets ของเราโดยอัตโนมัติ

สรุปคือ: สามารถทำได้แน่นอนครับ และเป็นโปรเจกต์ที่ทรงพลังมาก แต่เพื่อให้อ่านจุดโฟกัสได้แม่นยำ จะต้องใช้ ไฟล์ RAW ร่วมกับไลบรารี ExifTool และแนะนำให้รันกระบวนการวิเคราะห์ภาพ (Image Processing) บน Python แทนการทำบน Web Browser ครับ

จะทำอย่างไรต่อ ฉันสนใจโปรเจคนี้แล้ว

ดีใจมากๆ ครับที่คุณสนใจโปรเจคนี้! ถือเป็นโปรเจค DIY ที่ทรงคุณค่าและสนุกมากๆ สำหรับช่างภาพที่เป็นสาย Dev เพราะเราจะได้ผสมผสานระหว่าง "เทคโนโลยีการถ่ายภาพ" เข้ากับ "ระบบอัตโนมัติ" ของ Google Workspace ที่คุณถนัดได้อย่างลงตัวครับ

เพื่อให้คุณสามารถเริ่มต้นลุยโปรเจคนี้ต่อได้อย่างเป็นระบบ นี่คือ Roadmap และขั้นตอนปฏิบัติ (Action Plan) ที่คุณสามารถเริ่มทำได้ทันทีครับ:

ขั้นที่ 1: เตรียมอุปกรณ์และสภาพแวดล้อมการถ่ายภาพ (Test Environment Setup)
ความแม่นยำของการจูนเลนส์ขึ้นอยู่กับความนิ่งและสภาพแสงเป็นหลักครับ:

เป้าหมายทดสอบ (Focus Chart): ใช้ชาร์จทดสอบโฟกัสมาตรฐาน (เช่น SpyderLensCal หรือพิมพ์กระดาษ Test Chart ที่มีลายเส้นสลับดำ-ขาว คอนทราสต์สูงๆ)

การตั้งกล้อง: ติดตั้งกล้องบน ขาตั้งกล้อง (Tripod) ให้มั่นคง ห้ามขยับในระหว่างการทดสอบ และใช้สายลั่นชัตเตอร์หรือตั้งเวลาหน่วงชัตเตอร์ (Self-timer) เพื่อป้องกันภาพสั่นไหว

ระยะห่าง: กำหนดระยะห่างจากเซนเซอร์กล้องถึงเป้าหมายให้เหมาะสม (ตามคู่มือแนะนำของเลนส์รุ่นนั้นๆ เช่น ระยะ 25 เท่า หรือ 50 เท่าของทางยาวโฟกัส)

แสงสว่าง: ใช้แสงสว่างที่สม่ำเสมอ (แนะนำแสงธรรมชาติหรือไฟสตูดิโอที่มีค่า Kelvin คงที่) เพื่อให้ค่า Exposure ของทุกภาพนิ่งเท่ากัน

ขั้นที่ 2: ถ่ายภาพชุดทดสอบ (Shooting Sequence)
ทำการถ่ายภาพทดสอบโดยไล่ค่าปรับแก้โฟกัส (AFMA - Auto Focus Micro Adjustment) ในตัวกล้อง:

ถ่ายภาพที่ค่าชดเชยต่าง ๆ เช่น -10, -5, 0, +5, +10 (หรือละเอียดขึ้นเป็นทีละ 2 แต้ม เช่น -4, -2, 0, +2, +4)

คำแนะนำ: บันทึกเป็นไฟล์ JPEG (เพื่อให้ระบบ Web App ที่เราทำไว้ดึงค่า Exif และประเมินความคมชัดผ่าน OpenCV ได้ทันที) หรือจะถ่าย RAW แล้วแปลงเป็น JPEG เกรดดีก็ได้ครับ

ขั้นที่ 3: ทดสอบอัปโหลดเข้า Web App ที่สร้างขึ้น
เปิดลิงก์ Web App (Google Apps Script) ที่เราเพิ่งdeploy ไป

อัปโหลดภาพชุดแรก (ระบบจะดึงชื่อเลนส์และระยะซูมจาก Exif มาใส่ให้อัตโนมัติ)

กรอกค่า AFMA ที่ใช้ถ่ายภาพนั้น (เช่น -5) ลงในช่อง แล้วกด "วิเคราะห์ความคมชัดและบันทึก"

ระบบจะประเมินคะแนนความคมชัด (Sharpness Score) พร้อมติดป้ายระดับคุณภาพ และบันทึกข้อมูลทั้งหมดลงใน Google Sheet แผ่นงาน Log ของคุณโดยอัตโนมัติ

ขั้นที่ 4: การวิเคราะห์หาจุด Peak เพื่อนำไปตั้งค่าใน USB Dock
เมื่อคุณเก็บข้อมูลครบทุกค่า AFMA (เช่น -10 ถึง +10) ลงใน Google Sheets แล้ว:

ข้อมูลในชีทจะเริ่มเรียงตัวเป็นชุดตัวเลขความคมชัด

คุณสามารถสร้างกราฟเส้น (Scatter Plot / Line Chart) ใน Google Sheets โดยให้แกน X คือ AFMA Value และแกน Y คือ Sharpness Score

กราฟจะโค้งขึ้นเป็นรูป ระฆังคว่ำ (Parabola)

จุดสูงสุดของยอดโค้ง (Peak) คือค่าตัวเลขชดเชยที่แม่นยำที่สุด (เช่น คำนวณออกมาได้ค่าที่คมชัดที่สุดคือ +3.4)

นำค่าตัวเลขนี้ไปกรอกลงในโปรแกรม Sigma Optimization Pro แล้วเชื่อมต่อเลนส์ผ่าน Sigma USB Dock เพื่อเขียนค่าลงชิปเลนส์จริงได้เลยครับ

ขั้นที่ 5: การต่อยอดพัฒนาขั้นสูง (Optional / Future Upgrades)
ถ้าในอนาคตคุณอยากสนุกและอยากทำให้มันฉลาดขึ้นไปอีกขั้น คุณสามารถพัฒนาต่อยอดได้ตามไอเดียที่เราคุยกันไว้:

ทำระบบ Auto-Capture: เขียนสคริปต์ Python บนคอมพิวเตอร์เพื่อสั่งงานกล้องผ่านสาย USB (Tethering) ให้กดถ่ายภาพไล่ค่า AFMA ทีละรูปอัตโนมัติแบบไม่ต้องกดเอง

ดึงพิกัดจุดโฟกัส (Active AF Point): ขยับไปใช้ไลบรารี ExifTool เพื่ออ่าน MakerNotes ในไฟล์ RAW เชิงลึก ตรวจสอบว่าพิกัดที่กล้องโฟกัสตรงกับจุดที่คมที่สุดบนภาพจริงหรือไม่

คุณอยากจะเริ่มทดลองลุยจาก ขั้นตอนไหนก่อนดีครับ? (เช่น อยากลองเตรียมหน้าเว็บ / อยากทดลองถ่ายภาพชุดแรก / หรือต้องการให้ช่วยเขียนสูตรคำนวณหาจุด Peak ใน Google Sheets รอไว้ก่อน) แจ้งมาได้เลยครับ พร้อมลุยต่อเต็มที่!

อยากให้ช่วยตัดสินใจเริ่มต้นให้ด้วยว่าควรเริ่มจากอะไรดี

เพื่อไม่ให้คุณรู้สึกสับสนหรือลังเลว่าควรจะเริ่มจากตรงไหนดี ผมขออนุญาต "เคาะขวาและตัดสินใจเลือกจุดเริ่มต้นที่ดีที่สุด" ให้คุณเริ่มลุยทันทีตามสเต็ปนี้ครับ:

🏆 จุดเริ่มต้นที่ดีที่สุด: "เริ่มจากการเตรียมการทดสอบและถ่ายภาพชุดแรก"
เหตุผลที่เราควรเริ่มจากจุดนี้ก่อนเขียนโค้ดเพิ่ม เพราะ "ข้อมูลดิบ (Raw Data / Test Images)" คือหัวใจสำคัญที่สุด ถ้าไม่มีภาพถ่ายที่มีระยะห่างและค่าชดเชยที่ถูกต้อง เราจะไม่มีทางรู้เลยว่าโค้ด OpenCV ที่เราทำไว้ทำงานแม่นยำแค่ไหนครับ

🚀 ลงมือทำตาม 3 ข้อง่ายๆ นี้ในสัปดาห์นี้เลยครับ:
1. จัดฉากและอุปกรณ์เทสต์ (ใช้เวลาประมาณ 20 นาที)
เป้าหมาย: หาแผ่น Test Chart (หรือปริ้นท์กระดาษที่มีลวดลายเรขาคณิต/ตัวหนังสือคมๆ ติดไว้ที่ผนัง)

การเซ็ตอัพ: ตั้งกล้องบนขาตั้ง (Tripod) ให้ห่างจากชาร์จในระยะที่เหมาะสม (เช่น ระยะ 1.5 - 2 เมตร สำหรับเลนส์เทเล หรือตามคู่มือเลนส์) ล็อกขาตั้งห้ามขยับเด็ดขาด

แสง: เปิดไฟให้สว่างเท่ากันทุกช็อต เพื่อให้ค่าความสว่าง (Exposure) ไม่แกว่ง

2. ถ่ายภาพชุดทดสอบจริง 5 ช็อต (ใช้เวลาประมาณ 5 นาที)
ตั้งกล้องโหมด M (Manual) โฟกัสไปที่ชาร์จ แล้วถ่ายภาพโดยหมุนเปลี่ยนค่าชดเชยโฟกัสในตัวกล้อง (AFMA) ทีละสเต็ป เช่น:

ช็อตที่ 1: ตั้ง AFMA = -10 (กดถ่าย 1 รูป)

ช็อตที่ 2: ตั้ง AFMA = -5 (กดถ่าย 1 รูป)

ช็อตที่ 3: ตั้ง AFMA = 0 (กดถ่าย 1 รูป)

ช็อตที่ 4: ตั้ง AFMA = +5 (กดถ่าย 1 รูป)

ช็อตที่ 5: ตั้ง AFMA = +10 (กดถ่าย 1 รูป)
(เก็บบันทึกภาพเหล่านี้ไว้ใน SD Card หรือดึงลงคอมพิวเตอร์)

3. นำภาพมาทดสอบกับ Web App ที่เราทำไว้ (ใช้เวลาประมาณ 10 นาที)
เปิดลิงก์ Google Apps Script Web App ที่เราเพิ่งทำเสร็จขึ้นมา

หยิบรูปที่ถ่ายด้วยค่า -10 มาอัปโหลด (ระบบจะดึงชื่อเลนส์และระยะซูมให้อัตโนมัติ)

กรอกช่อง AFMA เป็น -10 แล้วกด วิเคราะห์ความคมชัดและบันทึก

ทำซ้ำกับรูปที่เหลือ (-5, 0, +5, +10) จนครบทุกรูป

ทำไมวิธีนี้ถึงเวิร์กที่สุด?
เพราะคุณจะได้เห็นผลลัพธ์ทันทีว่าคะแนนความคมชัด (Sharpness Score) ที่คำนวณออกมา มันเรียงตัวโดดเด่นที่ค่าไหน (เช่น ค่า 0 หรือ +5 อาจจะได้คะแนนพุ่งสูงที่สุด) ซึ่งจะทำให้คุณเห็นภาพชัดเจนเลยว่า ระบบที่เราสร้างขึ้นมันใช้งานได้จริง และพร้อมต่อยอดไปสู่การทำกราฟหาค่า Peak ต่อไปครับ

เริ่มจากข้อ 1 และ 2 (ไปตั้งกล้องถ่ายรูป 5 ช็อตนี้ก่อนเลยครับ) แล้วถ้าติดขัดตรงไหน หรือพร้อมจะเอาผลคะแนนมาวิเคราะห์ต่อ แจ้งผมได้เลยครับ ลุยกันยาวๆ โปรเจคนี้สนุกแน่นอน!

ถ่ายมาแล้วครับ

ยอดเยี่ยมเลยครับ!

ตอนนี้คุณได้ภาพถ่ายทดสอบ (Test Shots) ครบตามชุดแล้วใช่ไหมครับ? ถ้างั้นเรามาลุยขั้นตอนต่อไปกันเลย:

อัปโหลดรูปเข้า Web App: เปิดลิงก์หน้าเว็บที่คุณสร้างขึ้นมา แล้วอัปโหลดรูปภาพทดสอบทีละรูป (พร้อมกรอกค่า AFMA ของรูปนั้นๆ เช่น -10, -5, 0, 5, 10) แล้วกด "วิเคราะห์ความคมชัดและบันทึก" ได้เลยครับ

เช็กข้อมูลใน Google Sheets: เมื่ออัปโหลดครบทุกรูปแล้ว ให้ลองเปิดไฟล์ Google Sheets (finetuneCamera) ของคุณดู จะเห็นว่าคะแนนความคมชัดถูกบันทึกเรียงแถวไว้อย่างเป็นระเบียบพร้อมเทียบกับค่า AFMA แล้ว

ถ้าคุณลองอัปโหลดและบันทึกข้อมูลลง Sheets เรียบร้อยแล้ว แจ้งผมได้เลยนะครับ เดี๋ยวเรามาทำขั้นตอนถัดไป คือ "การพล็อตกราฟหาจุด Peak (ค่า AFMA ที่คมชัดที่สุดในทางคณิตศาสตร์)" กันต่อครับ! ลุยกันต่อได้เลยครับ

อัปโหลดเรียบร้อยแล้ว

ยอดเยี่ยมมากครับ! ตอนนี้ข้อมูลคะแนนความคมชัดของภาพชุดแรกถูกบันทึกลงใน Google Sheets เรียบร้อยแล้ว

เพื่อให้เราทราบว่าเลนส์ตัวนี้มีความแม่นยำที่สุดที่ค่า AFMA เท่าไหร่ ขั้นตอนถัดไปคือการ วิเคราะห์หาจุดยอด (Peak Sharpness) จากข้อมูลที่คุณเพิ่งบันทึกครับ

คุณสามารถเลือกวิธีทำต่อได้ตามความสะดวกเลยครับ:

ให้ผมช่วยเขียนสูตรคำนวณใน Google Sheets:
เราสามารถใช้ฟังก์ชันสถิติหรือสูตรกำลังสอง (Parabolic Curve Fitting) เพื่อคำนวณหาค่า Peak ออกมาเป็นตัวเลขเป๊ะๆ ได้โดยตรงในชีทของคุณทันที

สร้างกราฟเส้น (Chart):
ให้ Google Sheets พล็อตกราฟระฆังคว่ำ (แกน X เป็นค่า AFMA, แกน Y เป็นคะแนนความคมชัด) เพื่อให้เห็นภาพชัดเจนด้วยตาเปล่าว่าเส้นกราฟพุ่งสูงสุดที่จุดไหน

คุณอยากให้ผมช่วยไกด์วิธีทำกราฟ หรือเขียนสูตรคำนวณหาค่า AFMA ที่ดีที่สุดใน Google Sheets ต่อเลยดีครับ?

ดำเนินการต่อได้เลยครับ

ลุยต่อกันเลยครับ! เพื่อให้คุณสามารถหาค่าชดเชยโฟกัสที่แม่นยำที่สุด (Optimal AFMA) จากข้อมูลที่คุณอัปโหลดเข้าไปใน Google Sheets ได้อย่างง่ายดาย ผมได้เตรียม สูตรคำนวณทางคณิตศาสตร์ (Parabolic Curve Fitting) ที่คุณสามารถนำไปวางใน Google Sheets เพื่อหาจุดยอด (Peak) ออกมาเป็นตัวเลขทศนิยมได้ทันทีครับ

วิธีคำนวณหาค่า Peak (ค่า AFMA ที่คมชัดที่สุด) ใน Google Sheets
สมมติว่าในชีท Log ของคุณ:

คอลัมน์ E คือ AFMA Value (ค่าชดเชย เช่น -10, -5, 0, 5, 10)

คอลัมน์ F คือ Sharpness Score (คะแนนความคมชัดที่ระบบคำนวณให้)

คุณสามารถสร้างเซลล์สรุปผลด้านข้างหรือด้านล่างของตาราง แล้วใส่สูตรดังนี้ครับ:

1. หาสสัมประสิทธิ์ของสมการกำลังสอง (
y=ax 
2
 +bx+c)
ในทางสถิติ เราสามารถใช้ฟังก์ชัน LINEST ร่วมกับพลังของสมการพาราโบลาได้ โดยสร้างตารางย่อยหรือใส่สูตรคำนวณหาจุดยอด (Peak) ด้วยสูตรสำเร็จรูปด้านล่างนี้ครับ:

วางสูตรนี้ในเซลล์ที่ต้องการให้แสดง ค่า AFMA ที่คมชัดที่สุด (Optimal AFMA):

Excel
=LET(
  x, E2:E10, 
  y, F2:F10, 
  Xmat, FILTER({x^2, x, x^0}, x<>""),
  Ymat, FILTER(y, x<>""),
  coeffs, INDEX(LINEST(Ymat, Xmat, TRUE, FALSE), 1),
  a, INDEX(coeffs, 1),
  b, INDEX(coeffs, 2),
  -b / (2 * a)
)
(หมายเหตุ: ช่วงข้อมูล E2:E10 และ F2:F10 ให้ปรับเปลี่ยนตามแถวข้อมูลที่คุณบันทึกจริงใน Google Sheets ครับ)

สูตรนี้จะทำการคำนวณถดถอยพาราโบลา (Polynomial Regression) และคำนวณสูตรจุดยอด 
−b/(2a) ออกมาเป็นค่าตัวเลขที่แม่นยำระดับทศนิยมให้คุณทันที (เช่น คำนวณออกมาได้ +3.25 หรือ -1.50) ซึ่งตัวเลขนี้คือค่าที่คุณสามารถนำไปป้อนลงในโปรแกรม Sigma Optimization Pro เพื่อจูนเลนส์ผ่าน USB Dock ได้เลยครับ!

อีกหนึ่งวิธีที่มองเห็นภาพง่ายที่สุด: สร้างกราฟ (Scatter Plot)
หากคุณอยากเห็นรูปทรงของระฆังคว่ำด้วยตาตัวเอง:

ลากคลุมข้อมูลในคอลัมน์ AFMA Value (E) และ Sharpness Score (F)

ไปที่เมนูด้านบนเลือก แทรก (Insert) >แผนภูมิ (Chart)

ในหน้าต่างตั้งค่าแผนภูมิ (Chart editor) ให้เปลี่ยนประเภทแผนภูมิเป็น แผนภูมิกระจาย (Scatter chart) หรือ แผนภูมิเส้น (Line chart)

ในหัวข้อ ปรับแต่ง (Customize) > ชุดข้อมูล (Series) ให้ติ๊กเลือก เส้นแนวโน้ม (Trendline) แล้วเลือกประเภทเป็น พหุนาม (Polynomial) โดยกำหนดดีกรีเป็น 2 (Degree 2)

ติ๊กเลือก แสดงสมการ (Show equation) เพื่อดูสมการพาราโบลาในกราฟได้เลยครับ

ลองนำสูตรนี้ไปวางใน Google Sheets ดูครับ ติดขัดตรงตัวเลขหรือสูตรขึ้น Error ตรงไหน แจ้งผมได้เลยนะครับ เดี๋ยวผมช่วยปรับแก้ให้ทันที!

อยากให้แปลงสูตรไปไว้ในหน้าแดชบอร์ด เพื่อความสะดวกในการตรวจสอบข้อมูลครับ

ยอดเยี่ยมเลยครับ! การย้ายสูตรคำนวณไปไว้ใน หน้าแดชบอร์ดเฉพาะ (Dashboard Sheet) จะช่วยให้เราเห็นผลสรุปภาพรวมและค่า AFMA ที่ดีที่สุดของเลนส์แต่ละตัวได้ทันที โดยไม่ต้องคอยไล่ดูตาราง Log ดิบยาวๆ

เพื่อให้ทำหน้าแดชบอร์ดออกมาใช้งานได้สะดวกและดูเป็นระเบียบ ผมขอแนะนำให้เราสร้างแผ่นงาน (Sheet) เพิ่มอีก 1 หน้าชื่อว่า "Dashboard" แล้วออกแบบตารางสรุปผลให้ออกมาหน้าตาประมาณนี้ครับ:

📊 แนวทางการออกแบบหน้า Dashboard
คุณสามารถสร้างตารางสรุปผลในชีท Dashboard โดยดึงข้อมูลจากชีท Log มาคำนวณอัตโนมัติด้วยสูตร Google Sheets ดังนี้ครับ:

ช่องแสดงค่า AFMA ที่ดีที่สุด (Optimal Peak AFMA):
ใช้สูตร Parabolic Curve Fitting ที่เราคุยกันก่อนหน้านี้ มาใส่ไว้ในช่องสรุปผล เพื่อให้คำนวณหาค่าที่คมชัดที่สุดออกมาโชว์ตัวเลขโตๆ:

Excel
=LET(
  x, Log!E2:E100, 
  y, Log!F2:F100, 
  Xmat, FILTER({x^2, x, x^0}, (x<>"") * (ISNUMBER(x))),
  Ymat, FILTER(y, (x<>"") * (ISNUMBER(x))),
  coeffs, INDEX(LINEST(Ymat, Xmat, TRUE, FALSE), 1),
  a, INDEX(coeffs, 1),
  b, INDEX(coeffs, 2),
  IF(ISERROR(-b / (2 * a)), "ข้อมูลยังไม่เพียงพอ", -b / (2 * a))
)
ตารางสรุปสถิติล่าสุด (Latest Logs Summary):
ใช้สูตรดึงข้อมูล 5 แถวล่าสุดจากชีท Log มาแสดง เพื่อเช็กสถานะการทดสอบ:

Excel
=SORT(Log!A2:F100, 1, FALSE)
กราฟแสดงแนวโน้มความคมชัด (Parabolic Chart):
แทรกแผนภูมิกระจาย (Scatter Chart) ไว้ที่หน้าแดชบอร์ด โดยดึงข้อมูลจาก Log!E:F ตั้งค่า Trendline เป็น Polynomial กำลัง 2 เพื่อให้เห็นกราฟระฆังคว่ำโชว์เด่นชัดบนหน้าแดชบอร์ด

ให้ผมช่วยจัดการให้เลยไหมครับ?
คุณต้องการให้ผมเขียนคำสั่งเข้าไปสร้างชีท "Dashboard" และผูกสูตรคำนวณสรุปผลลงใน Google Sheets ให้คุณอัตโนมัติเลยหรือไม่ครับ? แจ้งมาได้เลย เดี๋ยวผมจัดให้ครับ!

ดำเนินการเลยครับ สร้างแดชบอร์ดให้สวยงามด้วยเลยครับ

ผมได้ดำเนินการสร้างหน้า Dashboard ให้เรียบร้อยแล้วครับ!

คุณสามารถคลิกเข้าไปดูผลงานและหน้าสรุปผลได้ที่ลิงก์นี้เลยครับ:finetuneCamera Dashboard


📊 สิ่งที่มีอยู่ในหน้าแดชบอร์ดใหม่:
การ์ดคำนวณค่า AFMA ที่ดีที่สุด (Optimal Peak AFMA):

ฝังสูตรคำนวณพาราโบลา (Parabolic Curve Fitting) แบบอัตโนมัติ

ระบบจะนำคะแนนความคมชัดจากชีท Log มาวิเคราะห์หาจุดยอด (Peak) และแสดงผลค่าชดเชยโฟกัสที่ดีที่สุดออกมาเป็นตัวเลขให้ทันทีที่คุณบันทึกข้อมูลครบ

การ과학สรุปสถิติภาพรวม (KPI Cards):

คะแนนความคมชัดสูงสุด (Max Sharpness Score)

จำนวนครั้งที่ทำการทดสอบทั้งหมด (Total Calibration Runs)

ตารางแสดงประวัติการทดสอบล่าสุด (Recent Calibration Test Logs):

ดึงข้อมูลย้อนหลังจากชีท Log มาแสดงผลแบบเรียลไทม์ เพื่อให้คุณตรวจทานข้อมูลแต่ละช็อตได้ทันที

ตอนนี้ระบบหน้าเว็บอัปโหลดภาพ (EXIF + OpenCV) เชื่อมต่อกับ Google Sheets และมีหน้า Dashboard สรุปผลครบถ้วนแล้วครับ คุณสามารถนำกล้องไปถ่ายเทสต์และอัปโหลดข้อมูลเข้าระบบได้ตามสะดวกเลยครับ มีจุดไหนอยากปรับแต่งเพิ่มแจ้งได้เลยนะครับ!

อยากได้ระบบที่สามารถอ่านจุดโฟกัสของภาพเพื่อวิเคราะห์ภาพถ่ายที่ได้ว่ามีลักษณะ back focus หรือ front focus รวมถึงสามารถดึงข้อมูลที่เป็นexifมาอ่านและประมวลผลได้เลย

เป็นไอเดียที่ทรงพลังและท้าทายมากครับ! การพัฒนาโปรแกรมให้สามารถ "อ่านจุดโฟกัสจากไฟล์ภาพ (Active AF Point)" พร้อมกับ "ดึงค่า EXIF" แล้วนำมาประมวลผลร่วมกับ "อัลกอริทึมวัดความคมชัด (OpenCV)" เพื่อวินิจฉัยว่าเลนส์มีอาการ Front Focus หรือ Back Focus หรือไม่นั้น เป็นสถาปัตยกรรมระดับโปรแกรมปรับจูนเลนส์มืออาชีพเลยทีเดียว

เพื่อให้คุณเห็นภาพรวมและแนวทางการพัฒนาต่อจากสิ่งที่เราทำไปแล้ว นี่คือ สถาปัตยกรรมและขั้นตอนการสร้างระบบนี้แบบเจาะลึกครับ:

1. ความท้าทายทางเทคนิคที่ต้องรู้ (ทำไมเบราว์เซอร์ถึงทำส่วนนี้ยาก?)
ข้อมูลจุดโฟกัส (MakerNotes): ข้อมูลระบุว่า "กล้องเลือกใช้จุดโฟกัสจุดใดในการถ่ายภาพ" ไม่ได้เก็บอยู่ใน EXIF มาตรฐานทั่วไป แต่ถูกซ่อนอยู่ในข้อมูลเฉพาะของผู้ผลิตที่เรียกว่า MakerNotes ซึ่งถูกเข้ารหัสไว้แตกต่างกันในแต่ละค่าย (เช่น Canon คือ .CR2/.CR3, Nikon คือ .NEF)

ข้อจำกัดของไฟล์ JPG: เมื่อกล้องหรือโปรแกรมแปลงไฟล์ RAW เป็น JPG ข้อมูลเชิงลึกของจุดโฟกัสส่วนใหญ่จะถูกตัดทิ้งไป

ข้อจำกัดของ Web App (Apps Script / JS): ไลบรารีบนเบราว์เซอร์อย่าง exif-js อ่านได้เฉพาะ EXIF มาตรฐาน (เช่น F-stop, Speed, Lens Model) แต่ ไม่สามารถถอดรหัส MakerNotes เพื่อดึงพิกัดจุดโฟกัส ออกมาได้

2. ทางออกและสถาปัตยกรรมที่ถูกต้อง (The Right Architecture)
หากต้องการให้ระบบอ่านจุดโฟกัสจากไฟล์ภาพเพื่อวินิจฉัย Front/Back Focus ได้จริงๆ เราจะต้องปรับโครงสร้างเครื่องมือเป็นแบบ Hybrid / Local Script (Python) ร่วมกับ Google Sheets ดังนี้ครับ:

ฝั่งประมวลผลหลัก (Python Script บนคอมพิวเตอร์ของคุณ):

ใช้ไลบรารี rawpy สำหรับเปิดไฟล์ RAW ของภาพถ่าย

ใช้ไลบรารี ExifTool (เครื่องมือสัญชาติ C/Perl ที่เก่งที่สุดในการอ่าน MakerNotes) เพื่อดึงพิกัดจุดโฟกัส (Active AF Point Coordinates) ออกมา

ใช้ OpenCV สแกนหาพิกัดพื้นที่ที่มีความคมชัดสูงสุด (Peak Sharpness) บนภาพ

เปรียบเทียบพิกัด (The Diagnostic Logic):

หากจุดที่คมที่สุด ตรงกับ พิกัดจุดโฟกัส 
→ Normal / Perfect Focus

หากจุดที่คมที่สุด อยู่หน้าจุดโฟกัส 
→ Front Focus

หากจุดที่คมที่สุด อยู่หลังจุดโฟกัส 
→ Back Focus

ฝั่งฐานข้อมูลและแดชบอร์ด (Google Sheets + Apps Script):

เมื่อสคริปต์ Python วิเคราะห์ผลลัพธ์เสร็จ (ได้ค่าว่า Front/Back กี่มิลลิเมตร หรือแนะนำให้ชดเชยค่า AFMA เท่าไหร่)

ให้สคริปต์ส่งข้อมูล (POST Request) วิ่งตรงมาบันทึกผลลงในชีท finetuneCamera และแสดงผลผ่านหน้า Dashboard ที่เราเพิ่งสร้างขึ้นอัตโนมัติ

3. แนวทางการพัฒนาต่อที่คุณสามารถเริ่มได้ทันที
หากคุณต้องการเริ่มเขียนโปรแกรม Python สำหรับใช้วเคราะห์เชิงลึกนี้ ผมสามารถช่วยคุณเขียนโครงสร้างสคริปต์ Python เบื้องต้นได้ทันที โดยสคริปต์จะทำหน้าที่:

รับไฟล์ภาพ RAW/JPEG เข้ามา

ดึงค่า EXIF และ MakerNotes

ตัดภาพเฉพาะจุดโฟกัสมาคำนวณค่าความคมชัด (Sharpness Gradient)

สรุปผลวินิจฉัยแล้วพ่นข้อมูลเข้า Google Sheets ของคุณ

คุณต้องการให้ผมเขียน โค้ดต้นแบบภาษา Python (Python Script Prototype) สำหรับเริ่มอ่านค่าและวิเคราะห์ภาพชุดนี้เตรียมไว้ให้เลยไหมครับ?

ฉันยังไม่เคยเขียนโปรแกรมด้วย Python ต้องเริ่มต้นอย่างไร

ยินดีต้อนรับสู่โลกของการเขียนโปรแกรมครับ! สำหรับคนที่มีพื้นฐานด้านระบบอัตโนมัติและ Web App อยู่แล้ว (เช่น Google Apps Script และ JavaScript) การมาจับ Python จะไม่ใช่เรื่องยากเลยครับ เพราะโครงสร้างและตรรกะการเขียนมีความคล้ายคลึงกันมาก แถม Python ยังอ่านง่ายและมีทรงพลังมากๆ ในงานด้านการประมวลผลภาพ (OpenCV) และการจัดการข้อมูล

