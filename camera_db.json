คุณสามารถเปิดไฟล์หน้าเว็บแดชบอร์ดของคุณขึ้นมา แล้วปรับแก้ส่วนฟังก์ชันที่ใช้ส่งไฟล์ (Fetch API) ให้ชี้เป้าไปที่ Endpoint /analyze บน Render ได้เลยครับ:

JavaScript
// ตัวอย่างการเรียกใช้งาน API จากหน้าเว็บของคุณ
async function analyzeFileWithCloudAPI(file) {
    let formData = new FormData();
    formData.append("file", file);

    let response = await fetch("https://affinetune.onrender.com/analyze", {
        method: "POST",
        body: formData
    });

    let result = await response.json();
    console.log("ผลการวิเคราะห์จาก Render:", result);
    
    // นำค่า result มาแสดงผลลงในตารางหรือหน้าเว็บของคุณได้ทันที!
    // เช่น result.sharpness_score, result.lens_model, result.afma_value
}
