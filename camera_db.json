📄 ไฟล์ที่ 3: Dockerfile (ตั้งค่าระบบเซิร์ฟเวอร์และ ExifTool)
เนื่องจากเซิร์ฟเวอร์ต้องการโปรแกรม ExifTool ในการแกะ MakerNotes จากไฟล์ RAW เราจึงต้องใช้ Dockerfile ในการติดตั้งครับ สร้างไฟล์ชื่อ Dockerfile (ไม่มีนามสกุล) แล้วใส่โค้ดนี้:

Dockerfile
FROM python:3.9-slim

# ติดตั้ง ExifTool และไลบรารีที่จำเป็นสำหรับ OpenCV
RUN apt-get update && apt-get install -y exiftool libgl1 libglib2.0-0

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# รัน FastAPI บนพอร์ต 7860 ซึ่งเป็นพอร์ตมาตรฐานของ Hugging Face Spaces
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
