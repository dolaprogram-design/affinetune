              3. แนะนำให้ถ่ายภาพทดสอบทั้งหมด <b>9 ภาพ</b> โดยไล่ค่าชดเชยดังนี้:<br>
                 <span style="display:inline-block; background:#fff; padding:5px 10px; margin-top:5px; border-radius:4px; border:1px solid #ccc;">-20, -15, -10, -5, 0, +5, +10, +15, +20</span><br>
              4. โฟกัสเป้าหมายใหม่ (Defocus แล้วกดโฟกัสใหม่) ทุกครั้งที่ถ่าย<br>
              5. นำไฟล์ภาพที่ได้มาอัปโหลดใน <b>เมนูที่ 2</b>`;
    } else {
      html = `<b>📷 สเปกกล้อง:</b> รองรับการปรับ Microadjustment / AF Fine Tune<br><br>
              <b>📝 ขั้นตอนการทดสอบ:</b><br>
              1. ตั้งกล้องบนขาตั้ง วางเป้าทดสอบโฟกัสให้สว่างและชัดเจน<br>
              2. ควรถ่ายภาพทีละสเต็ป (เช่น ทีละ 5 แต้ม) ครอบคลุมตั้งแต่ค่าลบสุดจนถึงบวกสุด<br>
              3. นำภาพทั้งหมดมาอัปโหลดที่เมนู 2 เพื่อหาจุดสูงสุด (Peak)`;
    }
    out.innerHTML = html;
    out.style.display = 'block';
  }

  // --- MENU 2: Multi Upload & Exif ---
  document.getElementById('multiFileInput').addEventListener('change', async function(e) {
    let files = e.target.files;
    if(files.length === 0) return;
    
    let tbody = document.getElementById('tableBody');
    tbody.innerHTML = "";
    testData = [];
    document.getElementById('hiddenImages').innerHTML = "";

    for(let i=0; i<files.length; i++) {
      let file = files[i];
      let rowId = 'row_' + i;
      let imgId = 'img_' + i;
      
      // ดึง EXIF
      let focal = "N/A";
      let lens = "N/A";
      let afmaHint = "";
      
      try {
        let ex = await exifr.parse(file, {makerNote: true});
        if(ex) {
          if(ex.LensModel) lens = ex.LensModel;
          else if(ex.Model) lens = ex.Model;
          if(ex.FocalLength) focal = ex.FocalLength + "mm";
        }
      } catch(err) { console.log(err); }

      // สร้าง img ซ่อนไว้ให้ OpenCV โหลด
      let imgElem = document.createElement('img');
      imgElem.id = imgId;
      imgElem.src = URL.createObjectURL(file);
      document.getElementById('hiddenImages').appendChild(imgElem);

      testData.push({ id: i, file: file, imgId: imgId, afma: null, sharpness: null });

      tbody.innerHTML += `
        <tr id="${rowId}">
          <td>${file.name}</td>
          <td><input type="number" id="afma_${i}" placeholder="เช่น -20, 0, 5" style="width:80px; text-align:center;"></td>
          <td style="font-size:12px; color:#555;">${lens}<br>${focal}</td>
          <td id="score_${i}">-</td>
          <td id="status_${i}" style="color:orange;">รอวิเคราะห์</td>
        </tr>
      `;
    }
    document.getElementById('analyzeAllBtn').style.display = 'block';
  });

  // วิเคราะห์ทุกภาพด้วย OpenCV
  function analyzeAllImages() {
    let btn = document.getElementById('analyzeAllBtn');
    btn.disabled = true;
    btn.innerText = "กำลังวิเคราะห์...";

    for(let i=0; i<testData.length; i++) {
      let afmaVal = document.getElementById('afma_' + i).value;
      if(afmaVal === "") {
        alert("กรุณากรอกค่าระยะ AFMA ให้ครบทุกช่องก่อนวิเคราะห์");
        btn.disabled = false; btn.innerText = "เริ่มวิเคราะห์ภาพทั้งหมดด้วย OpenCV";
        return;
      }
      testData[i].afma = parseFloat(afmaVal);
    }

    setTimeout(() => {
      for(let i=0; i<testData.length; i++) {
        try {
          let imgElem = document.getElementById(testData[i].imgId);
          let src = cv.imread(imgElem);
          let gray = new cv.Mat();
          let lap = new cv.Mat();
          
          cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY, 0);
          // Crop center 30% for better Focus Area analysis
          let h = gray.rows; let w = gray.cols;
          let ch = Math.floor(h * 0.3); let cw = Math.floor(w * 0.3);
          let sy = Math.floor((h - ch)/2); let sx = Math.floor((w - cw)/2);
          let rect = new cv.Rect(sx, sy, cw, ch);
          let roi = gray.roi(rect);

          cv.Laplacian(roi, lap, cv.CV_64F, 1, 1, 0, cv.BORDER_DEFAULT);
          let mean = new cv.Mat(), stddev = new cv.Mat();
          cv.meanStdDev(lap, mean, stddev);
          
          let variance = Math.pow(stddev.doubleAt(0, 0), 2);
          let score = parseFloat(variance.toFixed(2));
          testData[i].sharpness = score;
          
          document.getElementById('score_' + i).innerHTML = `<b>${score}</b>`;
          document.getElementById('status_' + i).innerHTML = `<span style="color:green;">สำเร็จ</span>`;

          src.delete(); gray.delete(); lap.delete(); roi.delete(); mean.delete(); stddev.delete();
        } catch(e) {
          document.getElementById('status_' + i).innerHTML = `<span style="color:red;">Error</span>`;
        }
      }
      btn.innerText = "วิเคราะห์เสร็จสิ้น ไปที่เมนู 3";
      
      // Auto switch to Menu 3
      setTimeout(() => openTab('menu3'), 1000);
    }, 100);
  }

  // --- MENU 3: Dashboard & Math ---
  function drawChart() {
    if(testData.length < 3 || testData[0].sharpness === null) {
      document.getElementById('optimalAfma').innerText = "ข้อมูลไม่เพียงพอ";
      return;
    }

    // Prepare data
    let points = testData.map(d => ({x: d.afma, y: d.sharpness})).sort((a,b) => a.x - b.x);
    let xVals = points.map(p => p.x);
    let yVals = points.map(p => p.y);

    // Simple peak finding (Parabolic Fit Approximation)
    // Find max actual point
    let maxIdx = 0; let maxY = -1;
    for(let i=0; i<points.length; i++){
       if(points[i].y > maxY) { maxY = points[i].y; maxIdx = i; }
    }
    
    // Suggest Peak
    let peakAfma = points[maxIdx].x;
    document.getElementById('optimalAfma').innerText = (peakAfma > 0 ? "+"+peakAfma : peakAfma);
    document.getElementById('peakScore').innerText = `(ความคมชัดสูงสุด: ${maxY})`;

    // Draw Chart.js
    if(chartInstance) chartInstance.destroy();
    let ctx = document.getElementById('afmaChart').getContext('2d');
    chartInstance = new Chart(ctx, {
      type: 'scatter',
      data: {
        datasets: [{
          label: 'ความคมชัดของภาพ (Sharpness Score)',
          data: points,
          backgroundColor: '#1a73e8',
          borderColor: '#1a73e8',
          pointRadius: 6,
          showLine: true,
          fill: false,
          tension: 0.4 // Smooth curve
        }]
      },
      options: {
        responsive: true,
        scales: {
          x: { title: { display: true, text: 'ค่า AF Fine Tune (AFMA)' }, ticks: { stepSize: 5 } },
          y: { title: { display: true, text: 'คะแนนความคมชัด (Variance)' } }
        },
        plugins: {
          tooltip: {
            callbacks: {
              label: function(ctx) { return `AFMA: ${ctx.parsed.x}, Score: ${ctx.parsed.y}`; }
            }
          }
        }
      }
    });
  }
</script>

</body>
</html>"""

