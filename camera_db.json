      </div>
      
      <div class="form-group">
        <label>ระยะซูม (Focal Length):</label>
        <input type="text" id="focalLength" placeholder="ดึงอัตโนมัติ หรือ กรอกเอง" required>
      </div>
      
      <div class="form-group">
        <label>ระยะห่างเป้าหมาย (Target Distance):</label>
        <input type="text" id="targetDistance" placeholder="เช่น 10m (กรอกเอง)" required>
      </div>
      
      <div class="form-group">
        <label>ค่าชดเชยโฟกัส (AFMA Value):</label>
        <input type="number" id="afmaValue" placeholder="เช่น -5, 0, 5 (กรอกเอง)" required>
      </div>
      
      <img id="imageSrc" />
      
      <button id="analyzeBtn" onclick="analyzeAndSave()" disabled>วิเคราะห์ความคมชัดและบันทึก</button>
      
