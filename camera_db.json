3. รันโค้ดวิเคราะห์ภาพและดึง EXIF (Cell ที่ 2):
สร้างเซลล์ใหม่ แล้ววางโค้ดด้านล่างนี้ กดรันแล้วเลือกไฟล์ .NEF ของคุณอัปโหลดขึ้นไปได้เลยครับ:

Python
import os
import cv2
import rawpy
import numpy as np
import exiftool
import matplotlib.pyplot as plt
from google.colab import files

print("📤 กรุณาอัปโหลดไฟล์ RAW (.NEF) เพื่อทดสอบ:")
uploaded = files.upload()

for filename in uploaded.keys():
    print(f"\n--- เริ่มต้นวิเคราะห์ไฟล์: {filename} ---")
    
    # ==========================================
    # ส่วนที่ 1: ดึงข้อมูล MakerNotes ด้วย ExifTool
    # ==========================================
    print("\n🔍 1. กำลังอ่านข้อมูล EXIF และ MakerNotes...")
    with exiftool.ExifToolHelper() as et:
        metadata = et.get_metadata(filename)[0]
        
    # คัดกรองและแสดงเฉพาะข้อมูลที่น่าสนใจเกี่ยวกับการโฟกัส
    keys_to_check = [
        "MakerNotes:AFFineTune", "MakerNotes:AFFineTuneAdj", "EXIF:FocalLength", 
        "EXIF:FNumber", "MakerNotes:LensModel", "MakerNotes:PrimaryAFPoint", 
        "MakerNotes:AFPointsUsed", "MakerNotes:FocusDistance"
    ]
    
    for key in keys_to_check:
        if key in metadata:
            # ตัดคำนำหน้า (เช่น MakerNotes:) ออกเพื่อให้อ่านง่าย
            clean_name = key.split(":")[-1]
            print(f"   ▶ {clean_name}: {metadata[key]}")
        else:
            # ลองค้นหาคำใกล้เคียงเผื่อกล้องแต่ละรุ่นใช้ชื่อ Tag ไม่เหมือนกัน
            for k, v in metadata.items():
                if "af" in k.lower() or "focus" in k.lower():
                     if "Point" in k or "Tune" in k:
                        print(f"   ▶ [พบข้อมูลสำรอง] {k.split(':')[-1]}: {v}")
                        break

    # ==========================================
    # ส่วนที่ 2: แปลงภาพ RAW และคำนวณความคมชัด
    # ==========================================
    print("\n🖼️ 2. กำลังแปลงไฟล์ RAW เป็นภาพและคำนวณความคมชัด...")
    try:
        # ใช้ rawpy เพื่อถอดรหัสภาพ RAW
        with rawpy.imread(filename) as raw:
            rgb_image = raw.postprocess(half_size=True) # ลดขนาดลงครึ่งนึงเพื่อให้ประมวลผลเร็วขึ้นบน Colab
            
        # แปลงเป็นขาวดำเพื่อป้อนเข้า OpenCV
        gray = cv2.cvtColor(rgb_image, cv2.COLOR_RGB2GRAY)
        
        # ครอปตรงกลาง 30%
        h, w = gray.shape
        ch, cw = int(h * 0.3), int(w * 0.3)
        sy, sx = (h - ch) // 2, (w - cw) // 2
        roi = gray[sy:sy+ch, sx:sx+cw]
        
        # คำนวณ Variance of Laplacian
        laplacian = cv2.Laplacian(roi, cv2.CV_64F)
        score = np.var(laplacian)
        
        print(f"   ✅ คำนวณสำเร็จ! คะแนนความคมชัด (Center ROI): {score:.2f}")
        
        # แสดงภาพพรีวิวขนาดเล็กเพื่อยืนยันว่าอ่านภาพได้จริง
        plt.figure(figsize=(4, 4))
        plt.imshow(cv2.cvtColor(roi, cv2.COLOR_GRAY2RGB))
        plt.title(f"Focus Area | Score: {score:.0f}")
        plt.axis('off')
        plt.show()

    except Exception as e:
        print(f"   ❌ เกิดข้อผิดพลาดในการประมวลผลรูปภาพ: {e}")
สคริปต์นี้จะแสดงให้เห็นถึง พลังของการทำงานฝั่ง Backend (Server-side) ว่าสามารถเจาะลึกเข้าไปอ่านค่าจุดโฟกัส (PrimaryAFPoint) และแปลงภาพไฟล์ NEF ดิบๆ ออกมาวิเคราะห์ได้แบบที่เบราว์เซอร์ปกติทำไม่ได้ครับ

ถ้าต้องการให้ OpenCV ครอปภาพไปตามพิกัดจุดโฟกัสที่อ่านได้จาก ExifTool เลย ต้องปรับโค้ดยังไง

การให้ OpenCV ครอปภาพตาม "พิกัดจุดโฟกัสจริง" แทนที่จะครอปตรงกลางภาพ เป็นวิธีที่ถูกต้องและแม่นยำที่สุดสำหรับการจูนเลนส์ครับ!

แต่มีความท้าทายเล็กน้อยตรงที่ กล้องแต่ละค่าย (หรือแม้แต่รุ่นต่างกัน) บันทึกข้อมูลจุดโฟกัสไม่เหมือนกัน บางค่ายบันทึกเป็นชื่อจุด (เช่น "Center", "Top", "C5") บางค่ายบันทึกเป็นพิกัด X, Y บนเซนเซอร์ (เช่น AFAreaXPosition)

เพื่อเป็นแนวทางนำไปประยุกต์ใช้ นี่คือ โค้ดสคริปต์ Python สำหรับรันบน Google Colab ที่ปรับปรุงใหม่ให้พยายามหาพิกัด (X, Y) ของจุดโฟกัส และให้ OpenCV ครอปภาพไปที่จุดนั้นโดยตรงครับ

💻 โค้ด Python ฉบับอัปเกรด (Crop by AF Point)
สามารถก๊อปปี้โค้ดนี้ไปรันแทนที่ส่วนที่ 2 (แปลงภาพ RAW) ใน Google Colab ได้เลยครับ:

Python
import os
import cv2
import rawpy
import numpy as np
import exiftool
import matplotlib.pyplot as plt
import matplotlib.patches as patches
from google.colab import files

print("📤 กรุณาอัปโหลดไฟล์ RAW (.NEF) เพื่อทดสอบ:")
uploaded = files.upload()

for filename in uploaded.keys():
    print(f"\n--- เริ่มต้นวิเคราะห์ไฟล์: {filename} ---")
    
    # ==========================================
    # ส่วนที่ 1: ดึงข้อมูล MakerNotes และพยายามหาพิกัด AF
    # ==========================================
    print("\n🔍 1. กำลังอ่านข้อมูล EXIF และ MakerNotes...")
    with exiftool.ExifToolHelper() as et:
        metadata = et.get_metadata(filename)[0]
    
    # ตัวแปรสำหรับเก็บพิกัดจุดโฟกัส (ถ้าหาเจอ)
    af_x_coord = None
    af_y_coord = None
    
    # ตัวอย่างการหาพิกัด X, Y ของจุดโฟกัส (ชื่อ Tag อาจเปลี่ยนไปตามกล้อง)
    # เช่น Nikon บางรุ่นเก็บเป็น AFAreaXPosition, AFAreaYPosition
    for key, value in metadata.items():
        if "AFAreaXPosition" in key or "AFPointPositionX" in key:
            af_x_coord = int(value)
        if "AFAreaYPosition" in key or "AFPointPositionY" in key:
            af_y_coord = int(value)
            
    print(f"   ▶ พิกัด AF ที่อ่านได้ (ดิบ): X={af_x_coord}, Y={af_y_coord}")

    # ==========================================
    # ส่วนที่ 2: แปลงภาพ RAW และคำนวณความคมชัด
    # ==========================================
    print("\n🖼️ 2. กำลังแปลงไฟล์ RAW และครอปตามจุดโฟกัส...")
    try:
        # ถอดรหัสภาพ RAW (ลดขนาดลงครึ่งนึงเพื่อความไวใน Colab)
        with rawpy.imread(filename) as raw:
            rgb_image = raw.postprocess(half_size=True) 
            
        gray = cv2.cvtColor(rgb_image, cv2.COLOR_RGB2GRAY)
        h, w = gray.shape
        
        # --- ตรรกะการเลือกจุดศูนย์กลางในการครอป (AF Point Targeting) ---
        if af_x_coord is not None and af_y_coord is not None:
            # ถ้ากล้องบอกพิกัด X, Y มาให้ ให้ใช้เป็นจุดศูนย์กลาง
            # หมายเหตุ: ถ้าใช้ rawpy แบบ half_size=True ต้องหารพิกัดด้วย 2 เพื่อให้ตรงสัดส่วนภาพ
            center_x = af_x_coord // 2
            center_y = af_y_coord // 2
            print("   ✅ ใช้พิกัด AF จากข้อมูลกล้องในการวิเคราะห์")
        else:
            # Fallback: ถ้าหาพิกัดไม่เจอ ให้บังคับกลับไปใช้ "ตรงกลางภาพ" เหมือนเดิม
            center_x = w // 2
            center_y = h // 2
            print("   ⚠️ ไม่พบพิกัด AF Point กลับไปใช้จุดกึ่งกลางภาพแทน (Center Focus)")
            
        # กำหนดขนาดกรอบที่ต้องการครอป (Crop Box Size)
        # เปลี่ยนจาก 30% ของภาพ เป็นขนาดคงที่ เช่น 400x400 พิกเซล (เพื่อให้แฟร์กับทุกรูป)
        box_size = 400 
        half_box = box_size // 2
        
        # คำนวณขอบเขตกรอบ ป้องกันไม่ให้ทะลุขอบรูปภาพ (Boundary Check)
        start_x = max(0, center_x - half_box)
        end_x = min(w, center_x + half_box)
        start_y = max(0, center_y - half_box)
        end_y = min(h, center_y + half_box)
        
        # สั่งตัดภาพเฉพาะจุดโฟกัส
        roi = gray[start_y:end_y, start_x:end_x]
        roi_rgb = rgb_image[start_y:end_y, start_x:end_x]
        
        # คำนวณความคมชัด
        laplacian = cv2.Laplacian(roi, cv2.CV_64F)
        score = np.var(laplacian)
        print(f"   🎯 คะแนนความคมชัด (AF Point ROI): {score:.2f}")
        
        # --- วาดกราฟฟิกแสดงให้เห็นชัดๆ ว่าระบบไปครอปตรงไหนมา ---
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(10, 5))
        
        # ภาพที่ 1: ภาพรวมพร้อมวาดกรอบสี่เหลี่ยมสีแดงตรงที่ระบบไปโฟกัสมา
        ax1.imshow(rgb_image)
        rect = patches.Rectangle((start_x, start_y), end_x - start_x, end_y - start_y, 
                                 linewidth=2, edgecolor='r', facecolor='none')
        ax1.add_patch(rect)
        ax1.set_title("Original Image & AF Box")
        ax1.axis('off')
        
        # ภาพที่ 2: ภาพที่ถูกครอปมาคำนวณคะแนน
        ax2.imshow(roi_rgb)
        ax2.set_title(f"Cropped AF Area\nSharpness Score: {score:.0f}")
        ax2.axis('off')
        
        plt.tight_layout()
        plt.show()

    except Exception as e:
        print(f"   ❌ เกิดข้อผิดพลาดในการประมวลผล: {e}")
💡 จุดสำคัญที่ถูกปรับเปลี่ยนในโค้ดนี้:
ค้นหาพิกัด X,Y: โค้ดจะวนลูปดูว่ามีแท็กที่ชื่อลงท้ายด้วย XPosition หรือ YPosition หรือไม่ (ปกติข้อมูลจำพวกนี้จะอยู่ใน MakerNotes)

ชดเชยสัดส่วน (Scaling Check): ใน Colab เราให้ rawpy โหลดรูปแบบย่อขนาด 50% (half_size=True) เพื่อให้ไม่กินแรม ดังนั้นตัวเลขพิกัดโฟกัสที่อ่านได้จาก Exif จึงต้องถูก // 2 ให้ตรงกับพิกเซลของภาพย่อด้วยครับ

Boundary Check (กัน Error): กรณีที่จุดโฟกัสไปอยู่ริมขอบภาพมากๆ โค้ด max(0, ...) และ min(h, ...) จะช่วยป้องกันไม่ให้กรอบครอปทะลุขอบจอจนทำให้โค้ดพัง

แสดงภาพกรอบสีแดง (Visualization): โค้ดจะพลอตภาพโชว์ 2 รูปคู่กัน รูปแรกโชว์ภาพเต็มพร้อมตีเส้นกรอบสีแดงครอบจุดโฟกัสเอาไว้ เพื่อให้คุณเช็กได้ทันทีด้วยตาเปล่าว่า "มันไปดึงตรงจุดโฟกัสที่เราตั้งใจถ่ายจริงๆ ไหม!"

คุณสามารถนำไฟล์ .NEF เข้าไปเทสต์ได้เลยครับ ว่า ExifTool อ่านพิกัด X, Y ของ Nikon D810 ตัวเก่งของคุณเจอหรือไม่ครับ!

test แล้วผ่านครับ ต่อไปจะพัฒนาในส่วนไหนต่อครับ

ยอดเยี่ยมมากครับ! การที่คุณเทสต์สคริปต์บน Colab ผ่าน แปลว่าตอนนี้เรามี "เครื่องยนต์หลัก (Core Engine)" ที่ทรงพลังที่สุดอยู่ในมือแล้ว (อ่าน RAW ได้, หาพิกัด AF เจอ, และครอปภาพแม่นยำ)

เพื่อประกอบร่างโปรเจกต์นี้ให้กลายเป็น "ระบบปรับจูนเลนส์ระดับโปร (Pro Lens Calibration System)" ที่สมบูรณ์แบบ 100% นี่คือแผนที่การเดินทาง (Roadmap) ในเฟสต่อไปครับ:

🗺️ แผนการพัฒนาในก้าวต่อไป (Next Steps)
1. พัฒนา Python ให้เป็น API Server (The Backend Engine)
ตอนนี้โค้ดรันอยู่บน Colab ซึ่งต้องกดรันทีละเซลล์ เราต้องแปลงโค้ดชุดนี้ให้เป็น FastAPI เพื่อรอรับภาพจากหน้าเว็บแทน

จุดที่ต้องตัดสินใจ: ไฟล์ RAW มีขนาดใหญ่มาก (30-50MB) ถ้านำ API ไปไว้บน Cloud (เช่น Vercel) การอัปโหลด 9 ภาพอาจใช้เวลานาน ผมแนะนำให้ทำเป็น Local API Server (รัน Python บนคอมพิวเตอร์ของคุณเองในพื้นหลัง) จะทำให้ประมวลผลไฟล์ RAW ได้เร็วทะลุขีดจำกัดเลยครับ

2. เชื่อมต่อหน้าเว็บเข้ากับ Python (Frontend to Backend)
ปรับแก้ไฟล์ HTML (แดชบอร์ด 4 เมนู) ของเรา ให้เปลี่ยนจากการใช้ OpenCV.js บนเบราว์เซอร์ มาเป็นการส่งไฟล์ภาพ (RAW/JPEG) ยิงไปให้ Python API ของเราเป็นคนวิเคราะห์แทน แล้วรับค่ากลับมาแสดงผลบนตารางและกราฟ

3. เชื่อมต่อฐานข้อมูล Google Sheets (Data Logging)
เมื่อหน้าเว็บได้รับผลการคำนวณและค่าความคมชัดที่แม่นยำที่สุดจาก Python แล้ว จะสั่งยิงข้อมูลไปบันทึก (Append) ลงใน Google Sheets อัตโนมัติ เพื่อให้หน้า Dashboard บน Google Sheets อัปเดตข้อมูลแบบเรียลไทม์

4. ปรับแต่งระบบแนะนำค่า AFMA อัจฉริยะ (Smart Diagnosis)
เขียนตรรกะเพิ่มใน Python เพื่อวิเคราะห์ว่า กราฟที่ได้เป็น Front Focus หรือ Back Focus อย่างชัดเจนหรือไม่ และให้ระบบสามารถประเมินได้ว่าภาพชุดนี้เชื่อถือได้แค่ไหน (เช่น ถ้ากราฟไม่เป็นรูปพาราโบลา ให้แจ้งเตือนว่า "ข้อมูลแกว่งเกินไป ควรถ่ายใหม่")

🚀 อยากลุยส่วนไหนก่อนดีครับ?
ผมแนะนำให้เราเริ่มจาก ส่วนที่ 1 (ทำ Python เป็น FastAPI Server) ก่อนครับ เพราะเป็นหัวใจสำคัญที่สุด

คุณอยากจะ:

ทำเป็น Local API (รันบนเครื่องตัวเอง): ประมวลผล RAW เร็วปรู๊ดปร๊าด ไม่ต้องรออัปโหลด

ทำเป็น Cloud API (ขึ้น Vercel/Render): ใช้งานได้ทุกที่ทุกเครื่อง แต่อาจต้องรอเวลาอัปโหลดไฟล์ RAW สักหน่อย

เลือกแนวทางที่ตอบโจทย์การใช้งานจริงของคุณที่สุดได้เลยครับ!

ส่วนที่ 1 เลยครับ แล้วค่อยพัฒนาไปเรื่อย ๆ

ยอดเยี่ยมครับ! การเลือกทำ Local API Server เป็นการตัดสินใจที่ถูกต้องที่สุดสำหรับงานที่ต้องประมวลผลไฟล์ RAW ขนาดใหญ่ครับ เพราะไม่ต้องเสียเวลาอัปโหลดไฟล์ขึ้นอินเทอร์เน็ต ภาพวิ่งตรงเข้าสคริปต์ Python ในเครื่องคุณเลย ประมวลผลเสร็จในไม่กี่วินาที

เพื่อให้เห็นภาพชัดเจน นี่คือโครงสร้างที่เรากำลังจะสร้างครับ:

Backend (Python FastAPI): รันบนคอมพิวเตอร์ของคุณ รอรับไฟล์ภาพจากหน้าเว็บ

Frontend (HTML/JS): หน้าเว็บที่เราทำไว้ จะชี้เป้าการส่งไฟล์ไปที่ http://localhost:8000/analyze แทน

🚀 ขั้นตอนการสร้าง Local API Server ด้วย Python (FastAPI)
1. ติดตั้งเครื่องมือในคอมพิวเตอร์ของคุณ
เปิด Command Prompt (Windows) หรือ Terminal (Mac) แล้วรันคำสั่งนี้เพื่อติดตั้งไลบรารีที่จำเป็นทั้งหมด:

Bash
pip install fastapi uvicorn rawpy opencv-python numpy pyexiftool python-multipart
(หมายเหตุ: เครื่องของคุณต้องติดตั้งโปรแกรม ExifTool ไว้ด้วยนะครับ หากยังไม่มี สามารถดาวน์โหลดได้จากเว็บไซต์หลักของ ExifTool)

2. สร้างไฟล์ main.py (หัวใจของ API)
สร้างโฟลเดอร์สำหรับโปรเจกต์ (เช่น lens-cal-api) แล้วสร้างไฟล์ชื่อ main.py ข้างใน นำโค้ดด้านล่างนี้ไปวาง:

ผมได้สร้างโค้ด Python สำหรับเปิดระบบ API Server เรียบร้อยแล้วครับ:

ไอคอน PY
main
 PY 
โค้ด main.py ด้านบนนี้ คือเอนจินที่จะรับไฟล์จากหน้าเว็บไปประมวลผล (อ่าน EXIF หาจุดโฟกัส, ครอปภาพตรงจุด, และคิดคะแนนความคมชัด) แล้วส่งค่าผลลัพธ์กลับมา

3. วิธีรันเซิร์ฟเวอร์
เปิด Command Prompt / Terminal ชี้ไปที่โฟลเดอร์ที่เก็บไฟล์ main.py แล้วพิมพ์คำสั่ง:

Bash
uvicorn main:app --reload
เมื่อเห็นข้อความว่า Uvicorn running on [http://127.0.0.1:8000](http://127.0.0.1:8000) ถือว่าระบบหลังบ้านพร้อมทำงานแล้วครับ!

🌐 ขั้นตอนถัดไป: ปรับหน้าเว็บให้คุยกับ API
ในก้าวต่อไป เราจะต้องไปแก้ไฟล์หน้าเว็บ (.html) ให้เลิกใช้ OpenCV บนเบราว์เซอร์ แล้วเปลี่ยนมาเป็นการส่งไฟล์รูป (ผ่าน Fetch API) ยิงพุ่งไปที่ [http://127.0.0.1:8000/analyze](http://127.0.0.1:8000/analyze) แทนครับ

ถ้าคุณรันเซิร์ฟเวอร์ uvicorn ตามข้อ 3 ได้สำเร็จโดยไม่ติด Error บอกผมได้เลยครับ! เราจะได้ลุยเขียนโค้ดหน้าเว็บส่วน Frontend ต่อกันเลย

There is a file you can reference named "main.py". Refer to this file by its name verbatim.

ถ้าจะเปิดระบบให้รองรับการใช้งานจากบุคคลทั่วไป จะมีวิธีใดที่สามารถทำงานได้อย่างเสถียร ไม่มีปัญหา

หากต้องการเปิดระบบ Pro Lens Calibration นี้ให้บุคคลทั่วไป (Public) ใช้งานได้อย่างเสถียร รองรับคนจำนวนมาก และไม่มีปัญหาจุกจิกเรื่องการตั้งค่าบนเครื่องผู้ใช้ (Local Environment) การทำเป็น Cloud API Server คือทางออกที่ดีที่สุดครับ

นี่คือแนวทางที่ผมแนะนำในการพัฒนาเพื่อนำไปเปิดให้บริการแบบ Public ครับ

1. แยก Frontend และ Backend ออกจากกันอย่างเด็ดขาด
Frontend (หน้าเว็บ HTML/JS): นำไฟล์ lens_dashboard_v7.html ไปโฮสต์บนบริการ Static Hosting ฟรีและเร็วอย่าง Vercel, Netlify, หรือ GitHub Pages (หรือแม้แต่ Google Sites / Blogger ก็ยังได้) เพื่อให้ผู้ใช้เปิดผ่าน URL ได้เลย

Backend (Python API): นำโค้ด main.py ที่ทำหน้าที่แปลง RAW และคำนวณคะแนน ไปโฮสต์บนบริการ Cloud API

2. ทางเลือกในการโฮสต์ Backend (Python API)
การโฮสต์ Python API ที่มีการใช้งาน rawpy, OpenCV, และ ExifTool มีข้อจำกัดเรื่องขนาดของไลบรารีและพื้นที่จัดเก็บชั่วคราว (Temp Storage) นี่คือตัวเลือกที่เหมาะสมครับ:

ตัวเลือก A: Render.com (Web Service) - แนะนำสำหรับเริ่มต้น

ข้อดี: ตั้งค่าง่าย รองรับ Docker (ซึ่งจำเป็นสำหรับการติดตั้ง ExifTool ในฝั่ง Server) มี Free Tier

ข้อเสีย: Free Tier จะมีการ "หลับ" (Sleep) หากไม่มีคนใช้นานๆ เวลาคนแรกมาเปิดอาจจะโหลดช้าประมาณ 30-50 วินาทีในครั้งแรก

สิ่งที่ต้องทำ:

สร้างไฟล์ Dockerfile เพื่อบอกเซิร์ฟเวอร์ว่าต้องติดตั้งอะไรบ้าง:

Dockerfile
FROM python:3.9-slim

# ติดตั้ง ExifTool
RUN apt-get update && apt-get install -y exiftool libgl1 libglib2.0-0

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000"]
สร้างไฟล์ requirements.txt:

Plaintext
fastapi
uvicorn
rawpy
opencv-python-headless
numpy
pyexiftool
python-multipart
นำโค้ดทั้งหมดขึ้น GitHub แล้วเชื่อมต่อกับ Render.com (เลือก Deploy เป็น Web Service ➔ Docker)

ตัวเลือก B: Google Cloud Run - แนะนำสำหรับความเสถียรระดับโปร

ข้อดี: เร็วมาก รองรับการสเกล (Auto-scaling) หากมีคนใช้เยอะๆ ก็ไม่ล่ม จ่ายเงินตามการใช้งานจริง (Pay-as-you-go) และมี Free Tier ที่ให้ใช้ฟรีจำนวนหนึ่งต่อเดือน

ข้อเสีย: ต้องผูกบัตรเครดิตตอนสมัคร (แม้จะไม่เกินโควต้าฟรี) การตั้งค่าซับซ้อนกว่าเล็กน้อย

สิ่งที่ต้องทำ: ใช้ Dockerfile แบบเดียวกับตัวเลือก A แล้วใช้ Google Cloud CLI สั่ง Deploy ขึ้น Cloud Run

ตัวเลือก C: Hugging Face Spaces (Gradio/FastAPI) - ทางเลือกที่ง่ายที่สุด

ข้อดี: ฟรี 100% ไม่หลับบ่อยเท่า Render รองรับการติดตั้งไลบรารีง่าย

ข้อเสีย: เครื่องฟรีอาจจะสเปกไม่สูงมาก การประมวลผลไฟล์ RAW หลายๆ ไฟล์พร้อมกันอาจจะช้า

สิ่งที่ต้องทำ: สร้าง Space ใหม่บน Hugging Face (เลือกเป็น SDK: Docker) แล้วนำไฟล์ทั้งหมดใส่เข้าไป

3. การปรับปรุงโค้ด Backend เพื่อความปลอดภัยและความเสถียร
หากจะเปิดให้คนทั่วไปใช้ ต้องเพิ่มการป้องกันในโค้ด main.py ครับ:

จำกัดขนาดไฟล์ (Rate Limiting & File Size Limit): ป้องกันคนอัปโหลดไฟล์ขนาดใหญ่เกินไป (เช่น วิดีโอ 1GB) เข้ามาจนเซิร์ฟเวอร์ล่ม FastAPI สามารถตั้งค่า MAX_UPLOAD_SIZE ได้

ลบไฟล์ขยะทันที (Auto-cleanup): สำคัญมาก! ในโค้ดปัจจุบันมีการสั่ง os.remove(temp_filename) ไว้ใน finally แล้ว ถือว่ามาถูกทางครับ แต่ต้องมั่นใจว่าไม่มีเคสไหนที่ไฟล์จะค้างอยู่ในเซิร์ฟเวอร์จนพื้นที่เต็ม

จัดการกับไฟล์ที่ไม่รองรับ: ต้องเช็กนามสกุลไฟล์ (Extension Check) ก่อนเสมอ ถ้าไม่ใช่ RAW หรือ JPEG ที่เรารองรับ ให้ Reject ไปเลย

4. การจัดการฐานข้อมูล (Database)
หากคุณต้องการเก็บข้อมูลการจูนเลนส์ของทุกคนไว้เป็นสถิติ (เช่น ผู้ใช้คนไหนใช้กล้องอะไร เลนส์อะไร ได้ค่า AFMA เท่าไหร่)

Google Sheets: สามารถใช้เป็นฐานข้อมูลเริ่มต้นได้ โดยให้ Backend (Python) ยิงข้อมูลผ่าน Google Sheets API (gspread) หรือยิงไปหา Google Apps Script (Web App) ของคุณอีกทอดหนึ่ง

Supabase / Firebase: หากข้อมูลเริ่มเยอะ (หลักหมื่นเรกคอร์ด) การเปลี่ยนไปใช้ฐานข้อมูลจริงอย่าง PostgreSQL (ผ่าน Supabase) หรือ NoSQL (ผ่าน Firebase) จะเสถียรและค้นหาข้อมูลได้เร็วกว่ามากครับ

ตอนนี้ได้ลงทะเบียนไว้ที่huggingface จะพัฒนาต่ออย่างไร

ยินดีด้วยครับ! การลงทะเบียนและมีบัญชีบน Hugging Face เรียบร้อยแล้ว ถือว่าคุณมี "ฐานทัพบนคลาวด์" สำหรับวางระบบ AI และ API ของโปรเจกต์ Lens Calibration นี้เรียบร้อยแล้วครับ

เนื่องจาก Hugging Face มีฟีเจอร์ที่เรียกว่า Hugging Face Spaces ซึ่งรองรับการรัน Python ด้วย Docker หรือ FastAPI ได้ฟรี เราสามารถเปลี่ยน Hugging Face Space ของคุณให้เป็น Public Cloud API Server เพื่อรองรับการใช้งานจริงได้เลยครับ

นี่คือ สเต็ปในการพัฒนาต่อทีละขั้นตอน เพื่อเปลี่ยน Hugging Face Spaces ให้กลายเป็นเซิร์ฟเวอร์ประมวลผลระบบจูนเลนส์ของคุณ:

สเต็ปที่ 1: เตรียมไฟล์โปรเจกต์สำหรับ Hugging Face Spaces
บน Hugging Face Space ที่คุณสร้างไว้ (แนะนำให้ตั้งค่า SDK เป็น Docker หรือ FastAPI) คุณจะต้องเตรียมไฟล์หลักๆ 3 ไฟล์ใน Space ของคุณครับ:

main.py (โค้ด FastAPI ที่เราเขียนไว้ก่อนหน้านี้สำหรับรับภาพ, อ่าน EXIF, และคำนวณ OpenCV)

requirements.txt (รายชื่อไลบรารีที่ต้องใช้):

Plaintext
fastapi
uvicorn
rawpy
opencv-python-headless
numpy
pyexiftool
python-multipart
Dockerfile (สำคัญมาก เพราะเซิร์ฟเวอร์ของ Hugging Face ต้องติดตั้งโปรแกรม ExifTool เพื่อใช้อ่าน MakerNotes จากไฟล์ RAW):

Dockerfile
FROM python:3.9-slim

# ติดตั้ง ExifTool และไลบรารีระบบที่ OpenCV ต้องใช้
RUN apt-get update && apt-get install -y exiftool libgl1 libglib2.0-0

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# รัน FastAPI บนพอร์ตที่ Hugging Face กำหนด (ปกติคือ 7860)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "7860"]
สเต็ปที่ 2: อัปโหลดโค้ดขึ้น Hugging Face Spaces
คุณสามารถอัปโหลดไฟล์ทั้ง 3 ไฟล์นี้ขึ้นไปบนหน้าเว็บ Hugging Face Space ของคุณได้เลย (กดปุ่ม Files and versions > Add file > Upload files) หรือจะใช้วิธี Clone ผ่าน Git มาทำบนเครื่องแล้ว Push ขึ้นไปก็ได้ครับ

เมื่ออัปโหลดเสร็จ ระบบจะทำการ Build Docker Image (ใช้เวลาประมาณ 2-3 นาที) หากสำเร็จ สถานะที่มุมบนของ Space จะเปลี่ยนเป็นสีเขียวคำว่า "Running"

สเต็ปที่ 3: ดึง URL ของ API ไปเชื่อมกับหน้าเว็บ
เมื่อ Space ของคุณรันอยู่ คุณจะได้ Public URL มาหน้าตาแบบนี้ครับ:[https://huggingface.co/spaces/ช](https://huggingface.co/spaces/ช)ื่อบัญชีของคุณ/ชื่อสเปซของคุณ/analyze

คุณสามารถนำ URL นี้ไปใส่ในไฟล์หน้าเว็บ HTML (lens_dashboard_v7.html) ของคุณ ในส่วนของการยิง Fetch API แทนที่จะชี้ไปที่ localhost:8000 ก็เปลี่ยนเป็น URL ของ Hugging Face แทน เพียงเท่านี้ หน้าเว็บของคุณก็จะส่งไฟล์ RAW/JPEG ไปให้ Hugging Face ช่วยประมวลผลให้ทันทีโดยที่คุณไม่ต้องเปิดคอมพิวเตอร์ทิ้งไว้เลย!

🎯 เป้าหมายถัดไปที่คุณอยากทำต่อคืออะไรดีครับ?
ปรับแก้ไฟล์ main.py ให้รองรับการรับภาพหลายๆ รูปพร้อมกันในทีเดียว (Batch Processing) เพื่อให้เข้ากับหน้าเว็บเมนูที่ 2

เขียนโค้ดเชื่อมต่อ Google Sheets ให้ API ตัวนี้ เมื่อคำนวณเสร็จแล้ว ยิงผลลัพธ์กลับไปบันทึกใน Google Sheets อัตโนมัติ

คุณอยากลุยทำส่วนไหนต่อก่อนดีครับ?

ส่วนแรก

เริ่มต้นลุยกันที่ "ส่วนที่ 1: การสร้าง Backend API (FastAPI) สำหรับรันบน Hugging Face Spaces" ครับ ซึ่งจะเป็นหัวใจหลักในการรับไฟล์ RAW/.NEF อ่านค่า EXIF/MakerNotes, ครอปพิกัดจุดโฟกัส และคำนวณคะแนนความคมชัด

เนื่องจาก Hugging Face Spaces รองรับการรันผ่าน Docker ได้อย่างสมบูรณ์แบบ เราจะเตรียมไฟล์สำคัญ 3 ไฟล์ เพื่ออัปโหลดขึ้นไปครับ:

📄 ไฟล์ที่ 1: main.py (โค้ดประมวลผลหลัก)
สร้างไฟล์ชื่อ main.py แล้ววางโค้ดนี้ลงไปครับ โค้ดนี้ถูกออกแบบมาให้รองรับทั้งไฟล์ JPEG และ RAW (.NEF, .CR2, ฯลฯ) พร้อมระบบค้นหาพิกัดจุดโฟกัสอัตโนมัติ:

Python
from fastapi import FastAPI, File, UploadFile, HTTPException
from fastapi.middleware.cors import CORSMiddleware
import cv2
import rawpy
import numpy as np
import exiftool
import os
import shutil

app = FastAPI()

# เปิดใช้งาน CORS เพื่อให้หน้าเว็บภายนอกยิง API เข้ามาได้
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

@app.get("/")
def read_root():
    return {"status": "Pro Lens Calibration API on Hugging Face is running!"}

@app.post("/analyze")
async def analyze_image(file: UploadFile = File(...)):
    temp_filename = f"temp_{file.filename}"
    with open(temp_filename, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    try:
        # 1. ดึงข้อมูล EXIF และ MakerNotes ด้วย ExifTool
        af_x_coord, af_y_coord = None, None
        afma_value = None
        lens_model, focal_length = "Unknown", "Unknown"

        with exiftool.ExifToolHelper() as et:
            metadata = et.get_metadata(temp_filename)[0]

            for key, value in metadata.items():
                if "AFAreaXPosition" in key or "AFPointPositionX" in key:
                    af_x_coord = int(value)
                if "AFAreaYPosition" in key or "AFPointPositionY" in key:
                    af_y_coord = int(value)
                if any(x in key for x in ["AFFineTuneAdj", "AFMicroAdj", "AFTuning"]):
                    afma_value = float(value)
                if "LensModel" in key:
                    lens_model = str(value)
                if "FocalLength" in key:
                    focal_length = str(value)

        # 2. แปลงภาพ RAW หรือ JPEG และประมวลผลความคมชัดด้วย OpenCV
        is_raw = temp_filename.lower().endswith(('.nef', '.cr2', '.arw', '.cr3', '.dng'))
        
        if is_raw:
            with rawpy.imread(temp_filename) as raw:
                rgb_image = raw.postprocess(half_size=True) 
            gray = cv2.cvtColor(rgb_image, cv2.COLOR_RGB2GRAY)
        else:
            img = cv2.imread(temp_filename)
            gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
            
        h, w = gray.shape
        scaling_factor = 2 if is_raw else 1

        # คำนวณพิกัดจุดศูนย์กลางในการครอป (ถ้ามีพิกัด AF ให้ใช้พิกัดจริง ถ้าไม่มีให้ใช้ตรงกลาง)
        if af_x_coord is not None and af_y_coord is not None:
            center_x = af_x_coord // scaling_factor
            center_y = af_y_coord // scaling_factor
            focus_status = "Used AF Point Coordinates"
        else:
            center_x = w // 2
            center_y = h // 2
            focus_status = "Used Center Crop"

        # ครอปกรอบขนาด 400x400 รอบจุดโฟกัส
        box_size = 400
        half_box = box_size // 2
        start_x = max(0, center_x - half_box)
        end_x = min(w, center_x + half_box)
        start_y = max(0, center_y - half_box)
        end_y = min(h, center_y + half_box)

        roi = gray[start_y:end_y, start_x:end_x]

        # คำนวณคะแนนความคมชัด (Variance of Laplacian)
        laplacian = cv2.Laplacian(roi, cv2.CV_64F)
        sharpness_score = float(np.var(laplacian))

        result = {
            "filename": file.filename,
            "sharpness_score": round(sharpness_score, 2),
            "afma_value": afma_value,
            "lens_model": lens_model,
            "focal_length": focal_length,
            "focus_status": focus_status,
            "af_coords": {"x": af_x_coord, "y": af_y_coord}
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
    finally:
        if os.path.exists(temp_filename):
            os.remove(temp_filename)

    return result
