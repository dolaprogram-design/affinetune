กด Deploy

เมื่อระบบ build เสร็จ (ใช้เวลาประมาณ 1-2 นาที) คุณจะได้ URL สาธารณะแบบ HTTPS เช่น:[https://lens-calibration-api.vercel.app](https://lens-calibration-api.vercel.app)

🔗 เชื่อมต่อ Cloud API กับ Google Apps Script (Code.gs)
เมื่อนำ Python API ขึ้น Cloud และได้ URL มาแล้ว ให้นำ URL นั้นมาอัปเดตไฟล์ Code.gs ในโปรเจกต์ Google Apps Script ของคุณเพื่อยิงไฟล์ภาพไปประมวลผล:

JavaScript
// URL ของ Cloud API ที่ได้จาก Vercel
const API_URL = "https://lens-calibration-api.vercel.app/api/analyze";

/**
 * ฟังก์ชันส่งภาพถ่ายจากหน้า Web App ไปยัง Cloud Python API
 * @param {string} base64Image - ข้อมูลภาพแบบ Base64 จากหน้าบ้าน
 * @param {string} fileName - ชื่อไฟล์ภาพ
 */
function processImageWithCloudAPI(base64Image, fileName) {
  try {
    // แปลง Base64 เป็น Blob
    const splitData = base64Image.split(',');
    const contentType = splitData[0].match(/:(.*?);/)[1];
    const decodedData = Utilities.base64Decode(splitData[1]);
    const imageBlob = Utilities.newBlob(decodedData, contentType, fileName);
    
    // จัดชุด Payload สำหรับส่งแบบ multipart/form-data
    const payload = {
      'file': imageBlob
    };
    
    const options = {
      'method': 'post',
      'payload': payload,
      'muteHttpExceptions': true
    };
    
    // เรียกไปยัง Python Cloud API
    const response = UrlFetchApp.fetch(API_URL, options);
    const result = JSON.parse(response.getContentText());
    
    return result; // จะคืนค่า { filename, sharpness_score, quality, af_point_x, af_point_y }
    
  } catch (error) {
    return { "error": error.toString() };
  }
}
เมื่อต่อเชื่อมระบบส่วนนี้เสร็จ เวลาผู้ใช้อัปโหลดรูปผ่านหน้า Web App ตัว Google Apps Script จะส่งไฟล์ไปยัง Python Cloud API บน Vercel เพื่อวิเคราะห์ภาพ แล้วนำผลลัพธ์ยิงกลับลง Google Sheets และ Dashboard โดยอัตโนมัติทันทีครับ

