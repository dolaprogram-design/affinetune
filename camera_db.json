เปลี่ยนจาก 4.5.0 เป็น 4.8.0 ตามโค้ดนี้:

HTML
<script async src="https://docs.opencv.org/4.8.0/opencv.js" onload="onOpenCvReady();" type="text/javascript"></script>
จากนั้นกดบันทึก นำไปใช้งานใหม่ (Deploy > Manage Deployments > กดรูปดินสอเปลี่ยนเวอร์ชันเป็น New) แล้วลองเปิดหน้าเว็บอีกครั้ง

ขอไฟล์index.html ที่ปรับแก้ไขOpencvใหม่ด้วยครับ

นี่คือไฟล์ Index.html ที่อัปเดตเวอร์ชันของลิงก์ OpenCV.js เป็นเวอร์ชัน 4.8.0 เรียบร้อยแล้วครับ

คุณสามารถคัดลอกโค้ดด้านล่างนี้ไปวางทับในไฟล์ Index.html เดิมใน Google Apps Script ได้เลยครับ

HTML
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lens Calibration Web App</title>
  <!-- อัปเดตลิงก์โหลดไลบรารี OpenCV.js เป็นเวอร์ชัน 4.8.0 -->
  <script async src="https://docs.opencv.org/4.8.0/opencv.js" onload="onOpenCvReady();" type="text/javascript"></script>
  <style>
    body { font-family: 'Sarabun', sans-serif; padding: 20px; max-width: 600px; margin: auto; background-color: #f8f9fa; }
    .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .form-group { margin-bottom: 15px; }
    label { display: block; font-weight: bold; margin-bottom: 5px; color: #333; }
    input[type="text"], input[type="number"], input[type="file"] { 
      width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; 
    }
    button { 
      width: 100%; padding: 12px; background-color: #1a73e8; color: white; 
      border: none; border-radius: 4px; font-size: 16px; cursor: pointer; font-weight: bold; 
    }
    button:disabled { background-color: #cccccc; cursor: not-allowed; }
    #status { margin-top: 15px; font-weight: bold; text-align: center; }
    #imageSrc { max-width: 100%; margin-top: 15px; border-radius: 4px; display: none; }
  </style>
</head>
<body>

  <div class="card">
    <h2 style="text-align: center; color: #1a73e8;">ระบบวิเคราะห์ความคมชัด<br>(Lens Calibration)</h2>
    
    <div id="loadingOpencv" style="text-align:center; color: #d93025; font-weight: bold;">
      กำลังโหลดเอนจิน OpenCV (v4.8.0)... โปรดรอสักครู่
    </div>
    
    <div id="mainForm" style="display:none;">
      <div class="form-group">
        <label>รุ่นเลนส์ (Lens Model):</label>
        <input type="text" id="lensModel" placeholder="เช่น Sigma 150-600mm Sports" required>
      </div>
      
      <div class="form-group">
        <label>ระยะซูม (Focal Length):</label>
        <input type="text" id="focalLength" placeholder="เช่น 600mm" required>
      </div>
      
      <div class="form-group">
        <label>ระยะห่างเป้าหมาย (Target Distance):</label>
        <input type="text" id="targetDistance" placeholder="เช่น 10m" required>
      </div>
      
      <div class="form-group">
        <label>ค่าชดเชยโฟกัส (AFMA Value):</label>
        <input type="number" id="afmaValue" placeholder="เช่น -5, 0, 5" required>
      </div>
      
      <div class="form-group">
        <label>อัปโหลดภาพถ่ายทดสอบ (JPEG/RAW-Extracted):</label>
        <input type="file" id="fileInput" accept="image/*" />
      </div>
      
      <img id="imageSrc" />
      
      <button id="analyzeBtn" onclick="analyzeAndSave()" disabled>วิเคราะห์ความคมชัดและบันทึก</button>
      
      <div id="status"></div>
    </div>
  </div>

  <script>
    let imgElement = document.getElementById('imageSrc');
    let inputElement = document.getElementById('fileInput');
    let analyzeBtn = document.getElementById('analyzeBtn');
    let statusDiv = document.getElementById('status');

    // ฟังก์ชันนี้จะถูกเรียกเมื่อ OpenCV โหลดเสร็จ
    function onOpenCvReady() {
      document.getElementById('loadingOpencv').style.display = 'none';
      document.getElementById('mainForm').style.display = 'block';
    }

    // แสดงภาพพรีวิวเมื่อผู้ใช้เลือกไฟล์
    inputElement.addEventListener('change', (e) => {
      if(e.target.files.length > 0) {
        imgElement.src = URL.createObjectURL(e.target.files[0]);
        imgElement.style.display = 'block';
        analyzeBtn.disabled = false;
        statusDiv.innerText = "พร้อมวิเคราะห์ภาพ";
        statusDiv.style.color = "green";
      }
    }, false);

    // ฟังก์ชันวิเคราะห์ภาพและส่งข้อมูลเข้า Google Sheets
    function analyzeAndSave() {
      let lensModel = document.getElementById('lensModel').value;
      let focalLength = document.getElementById('focalLength').value;
      let targetDistance = document.getElementById('targetDistance').value;
      let afmaValue = document.getElementById('afmaValue').value;

      if(!lensModel || !focalLength || !targetDistance || !afmaValue || !inputElement.files.length) {
        statusDiv.innerText = "กรุณากรอกข้อมูลให้ครบถ้วนและอัปโหลดภาพถ่าย";
        statusDiv.style.color = "red";
        return;
      }

      statusDiv.innerText = "กำลังวิเคราะห์ค่า MTF... (อาจใช้เวลาสักครู่ตามขนาดภาพ)";
      statusDiv.style.color = "blue";
      analyzeBtn.disabled = true;

      // หน่วงเวลาเล็กน้อยเพื่อให้ UI อัปเดตข้อความ "กำลังวิเคราะห์..." ก่อนดึง CPU ไปคำนวณ
      setTimeout(() => {
        try {
          // กระบวนการของ OpenCV.js
          let src = cv.imread(imgElement);
          let gray = new cv.Mat();
          let lap = new cv.Mat();
          
          // 1. แปลงเป็นขาวดำ
          cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY, 0);
          
          // 2. ใช้ Laplacian Edge Detection หาเส้นขอบภาพ
          cv.Laplacian(gray, lap, cv.CV_64F, 1, 1, 0, cv.BORDER_DEFAULT);
          
          // 3. หาค่าความแปรปรวน (Variance)
          let mean = new cv.Mat();
          let stddev = new cv.Mat();
          cv.meanStdDev(lap, mean, stddev);
          
          let variance = Math.pow(stddev.doubleAt(0, 0), 2);
          let sharpnessScore = variance.toFixed(2);
          
          statusDiv.innerText = "ความคมชัด: " + sharpnessScore + " | กำลังบันทึกลงฐานข้อมูล...";

          // ล้างหน่วยความจำของ OpenCV เพื่อป้องกัน Memory Leak
          src.delete(); gray.delete(); lap.delete(); mean.delete(); stddev.delete();

          // เรียกฟังก์ชันฝั่ง Server (Code.gs)
          google.script.run.withSuccessHandler(function(response) {
            statusDiv.innerText = "คะแนนความคมชัด: " + sharpnessScore + " | " + response;
            statusDiv.style.color = "green";
            analyzeBtn.disabled = false;
            
            // รีเซ็ตไฟล์และภาพพรีวิวเพื่อเตรียมเทสต์รูปถัดไป
            inputElement.value = "";
            imgElement.style.display = "none";
            
          }).withFailureHandler(function(error) {
            statusDiv.innerText = "เกิดข้อผิดพลาด: " + error.message;
            statusDiv.style.color = "red";
            analyzeBtn.disabled = false;
          }).saveToSheets(lensModel, focalLength, targetDistance, afmaValue, sharpnessScore);

        } catch (err) {
          statusDiv.innerText = "เกิดข้อผิดพลาดในการประมวลผล: " + err.message;
          statusDiv.style.color = "red";
          analyzeBtn.disabled = false;
        }
      }, 100);
    }
  </script>
</body>
</html>
สิ่งที่ต้องทำหลังจากวางโค้ด:
เพื่อให้ Google Apps Script อัปเดตโค้ดใหม่ไปยังหน้าเว็บ คุณต้องทำการ Deploy ใหม่เป็นเวอร์ชันใหม่ทุกครั้งที่มีการแก้โค้ดครับ

กดที่ปุ่ม การทำให้ใช้งานได้ (Deploy) ที่มุมขวาบน

เลือก จัดการการทำให้ใช้งานได้ (Manage deployments)

คลิกไอคอนรูป ดินสอ (Edit)

ในช่อง "เวอร์ชัน (Version)" ให้เลือก เวอร์ชันใหม่ (New version)

กดปุ่ม การทำให้ใช้งานได้ (Deploy)

เปิดลิงก์ URL เดิมขึ้นมาใหม่ (หรือกดรีเฟรชหน้าเว็บ) ระบบจะพยายามโหลด OpenCV ตัวใหม่ขึ้นมาครับ

หากต้องการให้โปรแกรมดึงข้อมูลจากค่าExifของภาพมาวิเคราะห์ได้เลยหรือไม่ โดยดึงข้อมูลที่มีอยู่ ส่วนรายละเอียดอื่น ๆ ที่ไม่มีให้เว้นเพื่อกรอกเพิ่มเติม รวมทั้งประเมินคุณภาพความคมชัดของภาพให้ด้วยว่าอยู่ในระดับใด

สามารถทำได้และเป็นไอเดียที่ดีมากครับ! การดึงค่า Exif (Exchangeable image file format) มากรอกอัตโนมัติจะช่วยลดเวลาทำงานลงได้มากครับ

ในการทำเช่นนี้ เราจะใช้ไลบรารีชื่อ exif-js เพิ่มเข้าไปในหน้าเว็บ เพื่อให้อ่านค่าจากไฟล์ภาพก่อนที่จะประมวลผล โดยสามารถดึงข้อมูลพื้นฐาน เช่น รุ่นเลนส์ (Lens Model) และ ระยะซูม (Focal Length) มาใส่ในช่องให้อัตโนมัติ ส่วนค่าที่มักไม่มีใน Exif เช่น ค่าชดเชยโฟกัส (AFMA) หรือระยะเป้าหมายที่แน่นอน จะเว้นว่างไว้ให้คุณกรอกเอง

พร้อมกันนี้ ผมได้เพิ่มลอจิกการ ประเมินคุณภาพความคมชัด โดยใช้เกณฑ์ของค่า Variance of Laplacian (ยิ่งค่าสูง ขอบภาพยิ่งมีคอนทราสต์ชัดเจน) แบ่งเป็นระดับ เบลอ, พอใช้, ดี และ คมชัดมาก

นี่คือไฟล์ Index.html ฉบับอัปเดตที่คุณสามารถนำไปวางทับของเดิมได้เลยครับ:

HTML
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lens Calibration Web App (Auto EXIF)</title>
  
  <!-- โหลดไลบรารี OpenCV.js -->
  <script async src="https://docs.opencv.org/4.8.0/opencv.js" onload="onOpenCvReady();" type="text/javascript"></script>
  <!-- โหลดไลบรารีอ่านค่า EXIF จากภาพ -->
  <script src="https://cdn.jsdelivr.net/npm/exif-js"></script>
  
  <style>
    body { font-family: 'Sarabun', sans-serif; padding: 20px; max-width: 600px; margin: auto; background-color: #f8f9fa; }
    .card { background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    .form-group { margin-bottom: 15px; }
    label { display: block; font-weight: bold; margin-bottom: 5px; color: #333; }
    input[type="text"], input[type="number"], input[type="file"] { 
      width: 100%; padding: 10px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; 
    }
    button { 
      width: 100%; padding: 12px; background-color: #1a73e8; color: white; 
      border: none; border-radius: 4px; font-size: 16px; cursor: pointer; font-weight: bold; margin-top: 10px;
    }
    button:disabled { background-color: #cccccc; cursor: not-allowed; }
    #status { margin-top: 15px; font-weight: bold; text-align: center; line-height: 1.5; }
    #imageSrc { max-width: 100%; margin-top: 15px; border-radius: 4px; display: none; }
    .quality-badge { padding: 4px 8px; border-radius: 4px; color: white; margin-left: 10px; }
  </style>
</head>
<body>

  <div class="card">
    <h2 style="text-align: center; color: #1a73e8;">ระบบวิเคราะห์ความคมชัดอัตโนมัติ<br>(Auto EXIF & Lens Calibration)</h2>
    
    <div id="loadingOpencv" style="text-align:center; color: #d93025; font-weight: bold;">
      กำลังโหลดเอนจิน OpenCV (v4.8.0)... โปรดรอสักครู่
    </div>
    
    <div id="mainForm" style="display:none;">
      
      <div class="form-group">
        <label>อัปโหลดภาพถ่ายทดสอบ (JPEG):</label>
        <input type="file" id="fileInput" accept="image/jpeg, image/jpg" />
        <small style="color: #666;">* ระบบจะดึงข้อมูลเลนส์และระยะซูมจากไฟล์อัตโนมัติ</small>
      </div>

      <div class="form-group">
        <label>รุ่นเลนส์ (Lens Model / Camera Model):</label>
        <input type="text" id="lensModel" placeholder="ดึงอัตโนมัติ หรือ กรอกเอง" required>
      </div>
      
      <div class="form-group">
        <label>ระยะซูม (Focal Length):</label>
        <input type="text" id="focalLength" placeholder="ดึงอัตโนมัติ หรือ กรอกเอง" required>
      </div>
      
      <div class="form-group">
        <label>ระยะห่างเป้าหมาย (Target Distance):</label>
        <input type="text" id="targetDistance" placeholder="เช่น 10m (กรอกเอง)" required>
      </div>
      
      <div class="form-group">
        <label>ค่าชดเชยโฟกัส (AFMA Value):</label>
        <input type="number" id="afmaValue" placeholder="เช่น -5, 0, 5 (กรอกเอง)" required>
      </div>
      
      <img id="imageSrc" />
      
      <button id="analyzeBtn" onclick="analyzeAndSave()" disabled>วิเคราะห์ความคมชัดและบันทึก</button>
      
      <div id="status"></div>
    </div>
  </div>

  <script>
    let imgElement = document.getElementById('imageSrc');
    let inputElement = document.getElementById('fileInput');
    let analyzeBtn = document.getElementById('analyzeBtn');
    let statusDiv = document.getElementById('status');

    function onOpenCvReady() {
      document.getElementById('loadingOpencv').style.display = 'none';
      document.getElementById('mainForm').style.display = 'block';
    }

    // เมื่อผู้ใช้อัปโหลดไฟล์ ให้ดึงค่า EXIF ก่อนเลย
    inputElement.addEventListener('change', function(e) {
      if(e.target.files.length > 0) {
        let file = e.target.files[0];
        
        // แสดงภาพพรีวิว
        imgElement.src = URL.createObjectURL(file);
        imgElement.style.display = 'block';
        
        statusDiv.innerText = "กำลังอ่านข้อมูล EXIF...";
        statusDiv.style.color = "blue";
        
        // ใช้ exif-js อ่านค่าจากภาพ
        EXIF.getData(file, function() {
          let lens = EXIF.getTag(this, "LensModel");
          let camera = EXIF.getTag(this, "Model");
          let focal = EXIF.getTag(this, "FocalLength");
          let distance = EXIF.getTag(this, "SubjectDistance");
          
          // กรอกข้อมูลลงฟอร์มให้อัตโนมัติ (ถ้ามี)
          if(lens) {
            document.getElementById('lensModel').value = lens;
          } else if (camera) {
            document.getElementById('lensModel').value = camera + " (ไม่ระบุรุ่นเลนส์)";
          }
          
          if(focal) {
            // FocalLength มักมาเป็นตัวเลข ต้องเติม mm
            document.getElementById('focalLength').value = focal + "mm";
          }
          
          if(distance) {
            document.getElementById('targetDistance').value = distance + "m";
          }

          analyzeBtn.disabled = false;
          statusDiv.innerText = "ดึงข้อมูลสำเร็จ! พร้อมวิเคราะห์ภาพ";
          statusDiv.style.color = "green";
        });
      }
    }, false);

    // ฟังก์ชันประเมินระดับความคมชัด
    function getQualityLevel(variance) {
      if (variance < 100) return { text: "เบลอมาก", color: "#dc3545" }; // แดง
      if (variance < 500) return { text: "พอใช้", color: "#ffc107" }; // เหลือง
      if (variance < 1500) return { text: "ดี", color: "#28a745" }; // เขียว
      return { text: "คมชัดมาก", color: "#17a2b8" }; // ฟ้า
    }

    function analyzeAndSave() {
      let lensModel = document.getElementById('lensModel').value;
      let focalLength = document.getElementById('focalLength').value;
      let targetDistance = document.getElementById('targetDistance').value;
      let afmaValue = document.getElementById('afmaValue').value;

      if(!lensModel || !focalLength || !targetDistance || !afmaValue || !inputElement.files.length) {
        statusDiv.innerText = "กรุณากรอกข้อมูลให้ครบถ้วน";
        statusDiv.style.color = "red";
        return;
      }

      statusDiv.innerText = "กำลังคำนวณอัลกอริทึม MTF... (อาจใช้เวลาตามขนาดภาพ)";
      statusDiv.style.color = "blue";
      analyzeBtn.disabled = true;

      setTimeout(() => {
        try {
          let src = cv.imread(imgElement);
          let gray = new cv.Mat();
          let lap = new cv.Mat();
          
          cv.cvtColor(src, gray, cv.COLOR_RGBA2GRAY, 0);
          cv.Laplacian(gray, lap, cv.CV_64F, 1, 1, 0, cv.BORDER_DEFAULT);
          
          let mean = new cv.Mat();
          let stddev = new cv.Mat();
          cv.meanStdDev(lap, mean, stddev);
          
          let variance = Math.pow(stddev.doubleAt(0, 0), 2);
          let sharpnessScore = variance.toFixed(2);
          
          // ประเมินคุณภาพ
          let quality = getQualityLevel(variance);
          let qualityHtml = `<span class="quality-badge" style="background-color: ${quality.color};">${quality.text}</span>`;

          statusDiv.innerHTML = `คะแนนความคมชัด: <b>${sharpnessScore}</b> ${qualityHtml} <br><small style="color:gray;">กำลังบันทึกลงฐานข้อมูล...</small>`;

          src.delete(); gray.delete(); lap.delete(); mean.delete(); stddev.delete();

          // บันทึกลง Google Sheets
          google.script.run.withSuccessHandler(function(response) {
            statusDiv.innerHTML = `คะแนนความคมชัด: <b>${sharpnessScore}</b> ${qualityHtml} <br><span style="color:green;">บันทึกข้อมูลลง Sheets สำเร็จ!</span>`;
            analyzeBtn.disabled = false;
            
            // เคลียร์ไฟล์ภาพเพื่อให้พร้อมถ่ายรูปถัดไป แต่ยังคงเก็บข้อมูล Exif ในช่องกรอกไว้ เผื่อเทสต์ระยะเดิม
            inputElement.value = "";
            imgElement.style.display = "none";
            
          }).withFailureHandler(function(error) {
            statusDiv.innerText = "เกิดข้อผิดพลาดในการบันทึก: " + error.message;
            statusDiv.style.color = "red";
            analyzeBtn.disabled = false;
          }).saveToSheets(lensModel, focalLength, targetDistance, afmaValue, sharpnessScore);

        } catch (err) {
          statusDiv.innerText = "เกิดข้อผิดพลาดในการประมวลผล: " + err.message;
          statusDiv.style.color = "red";
          analyzeBtn.disabled = false;
        }
      }, 100);
    }
  </script>
</body>
</html>
สิ่งที่ปรับปรุงในโค้ดนี้:
เพิ่ม EXIF.js: ระบบจะพยายามดึง LensModel, FocalLength และ SubjectDistance มาให้ทันทีที่อัปโหลดรูป

ประเมินความคมชัด (Quality Level): มีฟังก์ชันประเมินตัวเลข Variance ว่าอยู่ในเกณฑ์ใด (เบลอมาก, พอใช้, ดี, คมชัดมาก) พร้อมติดป้ายกำกับสี (Badge) ให้ดูง่ายๆ

ปรับ Workflow หลังบันทึกสำเร็จ: หลังจากวิเคราะห์และบันทึกภาพแรกลง Sheets เสร็จแล้ว ระบบจะล้างช่องอัปโหลดรูปภาพทิ้ง แต่จะคงข้อมูลตัวหนังสือ (เช่น ชื่อเลนส์ ระยะห่าง) เอาไว้ เพื่อให้คุณสะดวกเวลาอัปโหลดรูปภาพของระยะถัดไป (เช่น เปลี่ยนแค่ค่า AFMA จาก -5 เป็น 0 แล้วกดอัปโหลดรูปใหม่ได้เลย)

หมายเหตุ: เนื่องจาก Exif จะอ่านได้แม่นยำที่สุดจากไฟล์ JPEG ที่ออกมาจากกล้องโดยตรง หากภาพผ่านการส่งผ่าน Line หรือ Facebook ข้อมูล Exif มักจะถูกลบออกไปครับ แนะนำให้นำไฟล์จากกล้องหรือ SD Card ลงเครื่องแล้วทดสอบเลยครับ

